const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0x8000 size 0x1000;
    region module_cache: reu at 0x020000 size 0x010000;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
}

module enemy_window abi 1 {
    export tick;
}

fn tick(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE WINDOW\n", .{});
    c64.console.print("WINDOW OK\n", .{});
    c64.vic.border = 5;
}
