const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x010000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
}

module enemy_runtime abi 1 {
    export border = borderColor;
}

fn borderColor(seed: u8) callconv(.stack) u8 {
    return seed + 2;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE DISK RELOAD\n", .{});
    if (ZeroPage.module.loadFromDisk("enemy_runtime", "enemyrt")) {
        const first = ZeroPage.module.call("enemy_runtime", "border", .{3});
        ZeroPage.module.unload("enemy_runtime");
        if (first) |first_border| {
            if (!ZeroPage.module.isLoaded("enemy_runtime") and ZeroPage.module.loadFromDisk("enemy_runtime", "enemyrt")) {
                const second = ZeroPage.module.call("enemy_runtime", "border", .{3});
                if (second) |second_border| {
                    if (first_border == second_border) {
                        c64.console.print("RELOAD OK\n", .{});
                        c64.vic.border = second_border;
                    } else {
                        c64.console.print("RELOAD MISMATCH\n", .{});
                        c64.vic.border = 2;
                    }
                } else {
                    c64.console.print("SECOND CALL FAIL\n", .{});
                    c64.vic.border = 2;
                }
            } else {
                c64.console.print("SECOND LOAD FAIL\n", .{});
                c64.vic.border = 2;
            }
        } else {
            c64.console.print("FIRST CALL FAIL\n", .{});
            c64.vic.border = 2;
        }
    } else {
        c64.console.print("FIRST LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
