const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack zp sp 0xf7 fp 0xf9;
}

export fn main() callconv(.stack) void {
    var border: u8 = 2;
    var total: u8 = 0;
    var count: u8 = 0;

    while (count < 3) {
        total += 1;
        count += 1;
    }

    if (total == 3) {
        border = 5;
    }

    c64.vic.border = border;
}
