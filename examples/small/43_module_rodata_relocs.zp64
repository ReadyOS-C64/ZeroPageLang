const c64 = @import("c64");

const reloc_table = [_]u8{ 3, 5, 8, 13 };

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack;
}

module enemy_rodata_relocs abi 1 {
    export table_ptr = tablePtr;
    export bias;
}

fn tablePtr() callconv(.stack) usize {
    return @intFromPtr(&reloc_table[1]);
}

fn bias(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE RODATA RELOCS\n", .{});
    c64.console.print("RODATA RELOCS OK\n", .{});
    c64.vic.border = 5;
}
