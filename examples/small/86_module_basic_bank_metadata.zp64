const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x002000;
    region basic_window: c64 at 0xa000 size 0x0800 bank .ram_under_basic;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    window basic in basic_window;
    capacity = 2;
    current {
        file = "enemybb";
    }
    dependency math_core {
        file = "mathcore";
        window = basic;
    }
}

module enemy_basic_bank abi 1 {
    export tick;
    dependency math_core;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE BASIC BANK\n", .{});
    c64.console.print("BANK METADATA OK\n", .{});
    c64.vic.border = 5;
}
