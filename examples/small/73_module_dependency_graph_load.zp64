const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

extern module MathCore = math_core {
    fn add(value: u8) u8;
    fn is_five(value: u8) bool;
    fn wide(value: u16) u16;
}

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x002000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 4;
    current {
        file = "enemygrf";
    }
    dependency math_core {
        file = "mathcore";
        requires = .{.fixed_math};
    }
    dependency pathing {
        file = "pathing";
        requires = .{};
    }
    dependency fixed_math {
        file = "fixedmath";
        requires = .{};
    }
}

module enemy_graph_load abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    var ok = false;
    if (ZeroPage.module.loadDependencyGraph("math_core") and ZeroPage.module.isLoaded("math_core") and ZeroPage.module.isLoaded("fixed_math")) {
        if (MathCore.add(3)) |value| {
            if (value == 5) {
                ok = true;
            }
        }
    }
    c64.console.print("MODULE GRAPH LOAD\n", .{});
    if (ok) {
        c64.console.print("GRAPH LOAD OK\n", .{});
        c64.vic.border = 5;
    } else {
        c64.console.print("GRAPH LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
