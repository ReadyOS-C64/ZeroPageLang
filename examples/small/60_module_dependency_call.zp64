const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x001800;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 3;
    current {
        file = "enemydep";
    }
    dependency math_core {
        file = "mathcore";
    }
    dependency pathing {
        file = "pathing";
    }
}

module enemy_dep_call_demo abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE DEP CALL\n", .{});
    if (ZeroPage.module.loadDependency("math_core") and ZeroPage.module.loadDependency("pathing")) {
        const added = ZeroPage.module.call("math_core", "add", .{3});
        const is_five = ZeroPage.module.call("math_core", "is_five", .{5});
        const wide = ZeroPage.module.call("math_core", "wide", .{0x0100});
        const step = ZeroPage.module.call("pathing", "step", .{5});
        const again = ZeroPage.module.call("math_core", "add", .{4});
        if (added) |sum| {
            if (is_five) |ok_bool| {
                if (wide) |wide_value| {
                    if (step) |path_value| {
                        if (again) |again_value| {
                            if (sum == 5 and ok_bool and wide_value == 0x0201 and path_value == 9 and again_value == 6) {
                                c64.console.print("DEP CALL OK\n", .{});
                                c64.vic.border = 5;
                            } else {
                                c64.console.print("DEP CALL BAD\n", .{});
                                c64.vic.border = 2;
                            }
                        } else {
                            c64.console.print("AGAIN CALL NULL\n", .{});
                            c64.vic.border = 2;
                        }
                    } else {
                        c64.console.print("PATH CALL NULL\n", .{});
                        c64.vic.border = 2;
                    }
                } else {
                    c64.console.print("WIDE CALL NULL\n", .{});
                    c64.vic.border = 2;
                }
            } else {
                c64.console.print("BOOL CALL NULL\n", .{});
                c64.vic.border = 2;
            }
        } else {
            c64.console.print("ADD CALL NULL\n", .{});
            c64.vic.border = 2;
        }
    } else {
        c64.console.print("DEP LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
