const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x001000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 2;
    current {
        file = "enemyunl";
    }
    dependency math_core {
        file = "mathcore";
    }
}

module enemy_dep_unload_demo abi 1 {
    export tick;
    dependency math_core;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE DEP UNLOAD\n", .{});
    if (ZeroPage.module.loadDependency("math_core")) {
        const first = ZeroPage.module.call("math_core", "add", .{3});
        ZeroPage.module.unloadDependency("math_core");
        const unloaded = ZeroPage.module.call("math_core", "add", .{3});
        const reloaded = ZeroPage.module.loadDependency("math_core");
        const second = ZeroPage.module.call("math_core", "add", .{4});
        if (first) |first_value| {
            if (unloaded) |_| {
                c64.console.print("DEP UNLOAD BAD\n", .{});
                c64.vic.border = 2;
            } else {
                if (reloaded) {
                    if (second) |second_value| {
                        if (first_value == 5 and second_value == 6) {
                            c64.console.print("DEP UNLOAD OK\n", .{});
                            c64.vic.border = 5;
                        } else {
                            c64.console.print("DEP UNLOAD BAD\n", .{});
                            c64.vic.border = 2;
                        }
                    } else {
                        c64.console.print("RELOAD CALL NULL\n", .{});
                        c64.vic.border = 2;
                    }
                } else {
                    c64.console.print("DEP RELOAD FAIL\n", .{});
                    c64.vic.border = 2;
                }
            }
        } else {
            c64.console.print("DEP CALL NULL\n", .{});
            c64.vic.border = 2;
        }
    } else {
        c64.console.print("DEP LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
