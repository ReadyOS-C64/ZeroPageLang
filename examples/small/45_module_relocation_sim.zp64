const c64 = @import("c64");

const reloc_table = [_]u8{ 3, 5, 8, 13 };

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0x8000 size 0x1000;
    region module_cache: reu at 0x020000 size 0x010000;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
}

module enemy_reloc_sim abi 1 {
    export tick;
    export table_ptr = tablePtr;
}

fn bump(value: u8) callconv(.stack) u8 {
    return value + 1;
}

fn tick(value: u8) callconv(.stack) u8 {
    return bump(value);
}

fn tablePtr() callconv(.stack) usize {
    return @intFromPtr(&reloc_table[1]);
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE RELOC SIM\n", .{});
    c64.console.print("SIM OK\n", .{});
    c64.vic.border = 5;
}
