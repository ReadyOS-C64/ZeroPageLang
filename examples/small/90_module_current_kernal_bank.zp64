const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xe000 size 0x0800 bank .ram_under_kernal;
    region module_cache: reu at 0x030000 size 0x010000;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
}

module enemy_kernal_current abi 1 {
    export border;
}

fn border(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    c64.console.clear();
    var ok = false;
    if (ZeroPage.module.load("enemy_kernal_current")) {
        if (ZeroPage.module.call("enemy_kernal_current", "border", .{4})) |color| {
            ok = color == 5;
        }
    }
    c64.console.print("MODULE CURRENT KERNAL BANK\n", .{});
    if (ok) {
        c64.console.print("CURRENT KERNAL OK\n", .{});
        c64.vic.border = 5;
    } else {
        c64.console.print("CURRENT KERNAL BAD\n", .{});
        c64.vic.border = 2;
    }
}
