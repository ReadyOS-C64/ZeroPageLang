const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

extern module MathCore = math_core {
    fn add(value: u8) u8;
}

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x001000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 2;
    current {
        file = "enemydep";
        load = .manual;
    }
    dependency math_core {
        file = "mathcore";
        load = .on_demand;
    }
}

module enemy_dep_on_demand_demo abi 1 {
    export tick;
    dependency math_core;
}

fn tick(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    if (ZeroPage.module.call("math_core", "add", .{3})) |_| {}
    c64.console.clear();
    c64.console.print("MODULE DEP ON DEMAND\n", .{});
    if (ZeroPage.module.isLoaded("math_core")) {
        c64.console.print(" DEP ON DEMAND OK\n", .{});
        c64.vic.border = 5;
    } else {
        c64.console.print("DEP ON DEMAND BAD\n", .{});
        c64.vic.border = 2;
    }
}
