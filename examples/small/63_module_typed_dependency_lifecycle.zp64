const c64 = @import("c64");

extern module MathCore = math_core {
    fn add(value: u8) u8;
}

extern module Pathing = pathing {
    fn step(value: u8) u8;
}

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x001800;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 3;
    current {
        file = "enemydep";
    }
    dependency math_core {
        file = "mathcore";
    }
    dependency pathing {
        file = "pathing";
    }
}

module enemy_typed_dep_life_demo abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE TYPED LIFE\n", .{});
    if (MathCore.load()) {
        const first = MathCore.add(3);
        MathCore.unload();
        const after_unload = MathCore.add(3);
        const reloaded = MathCore.load();
        const second = MathCore.add(4);
        const path_loaded = Pathing.load();
        const path_value = Pathing.step(5);
        if (first) |first_value| {
            if (after_unload) |_| {
                c64.console.print("TYPED LIFE BAD\n", .{});
                c64.vic.border = 2;
            } else {
                if (reloaded and path_loaded) {
                    if (second) |second_value| {
                        if (path_value) |path_result| {
                            if (first_value == 5 and second_value == 6 and path_result == 9 and MathCore.isLoaded() and Pathing.isLoaded()) {
                                c64.console.print("TYPED LIFE OK\n", .{});
                                c64.vic.border = 5;
                            } else {
                                c64.console.print("TYPED LIFE BAD\n", .{});
                                c64.vic.border = 2;
                            }
                        } else {
                            c64.console.print("PATH CALL NULL\n", .{});
                            c64.vic.border = 2;
                        }
                    } else {
                        c64.console.print("RELOAD CALL NULL\n", .{});
                        c64.vic.border = 2;
                    }
                } else {
                    c64.console.print("TYPED RELOAD FAIL\n", .{});
                    c64.vic.border = 2;
                }
            }
        } else {
            c64.console.print("TYPED CALL NULL\n", .{});
            c64.vic.border = 2;
        }
    } else {
        c64.console.print("TYPED LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
