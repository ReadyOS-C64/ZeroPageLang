const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x001800;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 3;
    current {
        file = "enemyrt";
    }
    dependency math_core {
        file = "mathcore";
    }
    dependency pathing {
        file = "pathing";
    }
}

module enemy_deps abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE DEP LOAD\n", .{});
    if (ZeroPage.module.loadDependency("math_core") and ZeroPage.module.loadDependency("pathing") and ZeroPage.module.isLoaded("math_core") and ZeroPage.module.isLoaded("pathing")) {
        c64.console.print("DEP LOAD OK\n", .{});
        c64.vic.border = 5;
    } else {
        c64.console.print("DEP LOAD BAD\n", .{});
        c64.vic.border = 2;
    }
}
