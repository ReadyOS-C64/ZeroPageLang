const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack;
}

fn borderFrom(a: u8, b: u8) callconv(.stack) u8 {
    var total: u8 = a + b;
    if (total == 5) {
        return total;
    }
    return 2;
}

export fn main() void {
    var border: u8 = borderFrom(2, 3);
    c64.vic.border = border;
}
