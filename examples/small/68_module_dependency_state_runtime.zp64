const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x003000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 3;
    current {
        file = "enemyrt";
        discard_on_unload;
    }
    dependency math_core {
        file = "mathcore";
        persist_in_reu at 0x0400 size 2;
    }
    dependency pathing {
        file = "pathing";
        persist_in_reu at 0x0500 size 2;
    }
}

module enemy_dep_state_runtime_demo abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    const math_state: [*]volatile u8 = @ptrFromInt(0xc400);
    const path_state: [*]volatile u8 = @ptrFromInt(0xc500);

    c64.console.clear();
    c64.console.print("MODULE DEP STATE RUNTIME\n", .{});

    if (ZeroPage.module.loadDependency("math_core") and ZeroPage.module.loadDependency("pathing")) {
        const first = ZeroPage.module.call("math_core", "add", .{3});
        math_state[0] = 0x2a;
        math_state[1] = 0x37;
        const switched = ZeroPage.module.call("pathing", "step", .{5});
        path_state[0] = 0x44;
        path_state[1] = 0x55;
        const second = ZeroPage.module.call("math_core", "add", .{4});
        const third = ZeroPage.module.call("pathing", "step", .{6});
        if (first) |first_value| {
            if (switched) |switched_value| {
                if (second) |second_value| {
                    if (third) |third_value| {
                        if (first_value == 5 and switched_value == 9 and second_value == 6 and third_value == 10 and math_state[0] == 0x2a and path_state[0] == 0x44) {
                            ZeroPage.module.unloadDependency("pathing");
                            path_state[0] = 0;
                            path_state[1] = 0;
                            if (ZeroPage.module.loadDependency("pathing")) {
                                const reloaded = ZeroPage.module.call("pathing", "step", .{7});
                                if (reloaded) |value| {
                                    if (value == 11 and path_state[0] == 0x44 and path_state[1] == 0x55) {
                                        c64.console.print("DEP STATE RESTORE OK\n", .{});
                                        c64.vic.border = 5;
                                    } else {
                                        c64.console.print("DEP STATE BAD\n", .{});
                                        c64.vic.border = 2;
                                    }
                                } else {
                                    c64.console.print("DEP RELOAD NULL\n", .{});
                                    c64.vic.border = 2;
                                }
                            } else {
                                c64.console.print("DEP RELOAD FAIL\n", .{});
                                c64.vic.border = 2;
                            }
                        } else {
                            c64.console.print("DEP STATE BAD\n", .{});
                            c64.vic.border = 2;
                        }
                    } else {
                        c64.console.print("PATH CALL NULL\n", .{});
                        c64.vic.border = 2;
                    }
                } else {
                    c64.console.print("MATH CALL NULL\n", .{});
                    c64.vic.border = 2;
                }
            } else {
                c64.console.print("SWITCH CALL NULL\n", .{});
                c64.vic.border = 2;
            }
        } else {
            c64.console.print("FIRST CALL NULL\n", .{});
            c64.vic.border = 2;
        }
    } else {
        c64.console.print("DEP LOAD FAIL\n", .{});
        c64.vic.border = 2;
    }
}
