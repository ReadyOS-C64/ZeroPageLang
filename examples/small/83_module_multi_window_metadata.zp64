const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x002000;
    region aux_window: c64 at 0x6000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    window aux in aux_window;
    capacity = 4;
    current {
        file = "enemymw";
    }
    dependency math_core {
        file = "mathcore";
        window = aux;
        requires = .{.fixed_math};
    }
    dependency pathing {
        file = "pathing";
        requires = .{};
    }
    dependency fixed_math {
        file = "fixedmath";
        window = aux;
        requires = .{};
    }
}

module enemy_multi_window abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE MULTI WINDOW\n", .{});
    c64.console.print("WINDOW METADATA OK\n", .{});
    c64.vic.border = 5;
}
