const c64 = @import("c64");
const ZeroPage = @import("ZeroPage");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x002000;
    region staging_ram: c64 at 0x9000 size 0x0800;
    region aux_window: c64 at 0x6000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    window aux in aux_window;
    capacity = 4;
    current {
        file = "enemymwd";
    }
    dependency math_core {
        file = "mathcore";
        window = aux;
        requires = .{.fixed_math};
    }
    dependency pathing {
        file = "pathing";
        requires = .{};
    }
    dependency fixed_math {
        file = "fixedmath";
        window = aux;
        requires = .{};
    }
}

module enemy_multi_window_dispatch abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    var ok = false;
    const local_current = tick(4);
    if (ZeroPage.module.call("fixed_math", "bias", .{4}) == null and ZeroPage.module.acquireDependencyGraph("math_core")) {
        if (ZeroPage.module.call("math_core", "add", .{3})) |direct| {
            if (ZeroPage.module.call("fixed_math", "bias", .{4})) |transitive| {
                const local_again = tick(6);
                if (local_current == 5 and direct == 5 and transitive == 7 and local_again == 7) {
                    ok = true;
                }
            }
        }
    }
    c64.console.print("MODULE MULTI WINDOW DISPATCH\n", .{});
    if (ok) {
        c64.console.print("WINDOW DISPATCH OK\n", .{});
        c64.vic.border = 5;
    } else {
        c64.console.print("WINDOW DISPATCH BAD\n", .{});
        c64.vic.border = 2;
    }
}
