const c64 = @import("c64");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack;
}

module enemy_deps abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(state: u8) callconv(.stack) u8 {
    return state + 1;
}

export fn main() void {
    c64.console.clear();
    c64.console.print("MODULE DEPS\n", .{});
    c64.console.print("DEPS OK\n", .{});
    c64.vic.border = 5;
}
