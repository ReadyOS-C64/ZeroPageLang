const c64 = @import("c64");
const math = @import("math_demo.zp64");

const Marker = struct { x: u8, ch: u8 };

fn drawMeter(count: u8, ch: u8) void {
    var x: u8 = 0;
    while (x < count) {
        c64.screen.putAt(3 + x, 8, ch);
        x += 1;
    }
}

fn drawMarker(x: u8, ch: u8) void {
    c64.screen.putAt(x, 12, ch);
}

export fn main() void {
    c64.screen.clear();
    c64.vic.border = 5;

    var total: u8 = math.add8(2, 3);
    var ok: bool = math.isEqual8(total, 5);
    var screen_base: u16 = 1024;
    var signed_step: i8 = 1;
    var signed_base: i16 = 2048;
    var screen_ptr: usize = 1024;
    var marker = Marker{ .x = 12, .ch = '*' };

    c64.screen.putsAt(2, 2, "CORE LANGUAGE DEMO");
    c64.screen.putsAt(2, 3, "MODULE PARAM RETURN");
    c64.screen.putsAt(2, 4, "TOTAL OK STEP");
    c64.screen.hexAt(16, 4, total);
    c64.screen.hexAt(19, 4, ok);
    c64.screen.hexAt(22, 4, signed_step);
    c64.screen.putsAt(2, 10, "BASE=");
    c64.screen.hex16At(7, 10, screen_base);
    c64.screen.putsAt(13, 10, "I16=");
    c64.screen.hex16At(17, 10, signed_base);
    c64.screen.putsAt(23, 10, "PTR=");
    c64.screen.hex16At(27, 10, screen_ptr);
    c64.screen.putsAt(2, 11, "MARK=");
    c64.screen.hexAt(7, 11, marker.x);
    c64.screen.hexAt(10, 11, marker.ch);

    if (ok == true) {
        c64.screen.putsAt(2, 5, "BOOL IF OK");
    } else {
        c64.screen.putsAt(2, 5, "BOOL IF BAD");
    }

    drawMeter(total, '#');
    drawMarker(marker.x, marker.ch);
}
