const test6502 = @import("test6502");
const fp = @import("../../../../../../sampleapps/spreadsheet/float_rom.zp64");
const calc = @import("../../../../../../sampleapps/spreadsheet/calculate.zp64");
const dma = @import("../../../../../../sampleapps/spreadsheet/dma.zp64");
const store = @import("../../../../../../sampleapps/spreadsheet/store.zp64");
const results = @import("../../../../../../sampleapps/spreadsheet/results.zp64");
const expression = @import("../../../../../../sampleapps/spreadsheet/expression.zp64");
const lex = @import("../../../../../../sampleapps/spreadsheet/lex.zp64");
const bytes = @import("../../../../../../sampleapps/spreadsheet/bytes.zp64");
const math = @import("../../../../../../sampleapps/spreadsheet/numbers.zp64");

fn put(id: u16, a: u8, b: u8, c: u8, d: u8, e: u8, f: u8, g: u8, h: u8, i: u8, j: u8) void {
    var raw: [*]volatile u8 = @ptrFromInt(0xc000);
    raw[1] = a;
    raw[2] = b;
    raw[3] = c;
    raw[4] = d;
    raw[5] = e;
    raw[6] = f;
    raw[7] = g;
    raw[8] = h;
    raw[9] = i;
    raw[10] = j;
    raw[0] = 0;
    while (raw[0] < 10 and raw[raw[0] + 1] != 0) {
        raw[0] += 1;
    }
    store.write(3, id);
}

fn matches(id: u16, kind: u8, value: u16) bool {
    calc.evaluate(3, id);
    results.loadResult(3, id);
    return results.state() == kind and results.value() == value;
}

export fn main() void {
    results.reset(3);
    put(0, '2', 0, 0, 0, 0, 0, 0, 0, 0, 0);
    put(1, '=', 0x41, '1', '+', '3', '*', '4', 0, 0, 0);
    put(2, '=', 0x42, '1', '*', '2', 0, 0, 0, 0, 0);
    put(3, '=', 0x43, '1', '+', '1', 0, 0, 0, 0, 0);
    put(4, '=', 0x44, '1', '+', 0x42, '1', 0, 0, 0, 0);
    put(5, '=', 0x53, 0x55, 0x4d, '(', 0x41, '1', ':', 0x45, '1');
    // Close the range function and store the full 11-byte formula.
    var raw: [*]volatile u8 = @ptrFromInt(0xc000);
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 5);
    test6502.expectEqualBool(1, true, matches(5, 2, 116));

    put(0, '4', 0, 0, 0, 0, 0, 0, 0, 0, 0);
    store.invalidate(3);
    test6502.expectEqualBool(2, true, matches(5, 2, 134));

    put(6, '=', 0x48, '1', 0, 0, 0, 0, 0, 0, 0);
    put(7, '=', 0x47, '1', 0, 0, 0, 0, 0, 0, 0);
    put(8, '=', 0x47, '1', '+', '1', 0, 0, 0, 0, 0);
    test6502.expectEqualBool(3, true, matches(8, 7, 0));
    test6502.expectEqualBool(4, true, matches(7, 7, 0));
    put(1535, '=', 0x50, '9', '7', 0, 0, 0, 0, 0, 0);
    test6502.expectEqualBool(5, true, matches(1535, 6, 0));
    put(1534, '=', '1', '/', '0', 0, 0, 0, 0, 0, 0);
    test6502.expectEqualBool(6, true, matches(1534, 9, 0));
    put(1533, '=', '(', '3', '+', '1', ')', '*', '2', 0, 0);
    test6502.expectEqualBool(7, true, matches(1533, 2, 8));
    put(1532, 0x54, 0x45, 0x58, 0x54, 0, 0, 0, 0, 0, 0);
    test6502.expectEqualBool(8, true, matches(1532, 3, 0));

    // =AVG(A1:B1) has an exact integer result. Fractional cases run in VICE.
    put(29, '=', 0x41, 0x56, 0x47, '(', 0x41, '1', ':', 0x42, '1');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 29);
    test6502.expectEqualBool(9, true, matches(29, 2, 10));

    // =MIN(A1:E1)
    put(30, '=', 0x4d, 0x49, 0x4e, '(', 0x41, '1', ':', 0x45, '1');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 30);
    test6502.expectEqualBool(10, true, matches(30, 2, 4));

    // =MAX(A1:E1)
    put(31, '=', 0x4d, 0x41, 0x58, '(', 0x41, '1', ':', 0x45, '1');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 31);
    test6502.expectEqualBool(11, true, matches(31, 2, 49));

    // =COUNT(A1:E1)
    put(32, '=', 0x43, 0x4f, 0x55, 0x4e, 0x54, '(', 0x41, '1', ':');
    raw[11] = 0x45;
    raw[12] = '1';
    raw[13] = ')';
    raw[0] = 13;
    store.write(3, 32);
    test6502.expectEqualBool(12, true, matches(32, 2, 5));

    // =PROD(A1:B1)
    put(33, '=', 0x50, 0x52, 0x4f, 0x44, '(', 0x41, '1', ':', 0x42);
    raw[11] = '1';
    raw[12] = ')';
    raw[0] = 12;
    store.write(3, 33);
    test6502.expectEqualBool(13, true, matches(33, 2, 64));

    // =ABS(-11)
    put(34, '=', 0x41, 0x42, 0x53, '(', '-', '1', '1', ')', 0);
    test6502.expectEqualBool(14, true, matches(34, 2, 11));

    // =AVG(A96:B96)
    put(35, '=', 0x41, 0x56, 0x47, '(', 0x41, '9', '6', ':', 0x42);
    raw[11] = '9';
    raw[12] = '6';
    raw[13] = ')';
    raw[0] = 13;
    store.write(3, 35);
    test6502.expectEqualBool(15, true, matches(35, 9, 0));

    // =A1:B1
    put(36, '=', 0x41, '1', ':', 0x42, '1', 0, 0, 0, 0);
    test6502.expectEqualBool(16, true, matches(36, 5, 0));

    // =ABS(-32767). VICE covers promotion at -32768.
    put(37, '=', 0x41, 0x42, 0x53, '(', '-', '3', '2', '7', '6');
    raw[11] = '7';
    raw[12] = ')';
    raw[0] = 12;
    store.write(3, 37);
    test6502.expectEqualBool(17, true, matches(37, 2, 32767));

    // =SUM(B1:A2)
    put(38, '=', 0x53, 0x55, 0x4d, '(', 0x42, '1', ':', 0x41, '2');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 38);
    test6502.expectEqualBool(18, true, matches(38, 2, 20));

    // =P96+A1
    put(39, '=', 0x50, '9', '6', '+', 0x41, '1', 0, 0, 0);
    test6502.expectEqualBool(19, true, matches(39, 6, 0));

    // =1+
    put(40, '=', '1', '+', 0, 0, 0, 0, 0, 0, 0);
    test6502.expectEqualBool(20, true, matches(40, 5, 0));

    // =$A$1 + SUM(A$1:$B1), with mixed locks on both endpoints.
    put(41, '=', '$', 0x41, '$', '1', '+', 0x53, 0x55, 0x4d, '(');
    raw[11] = 0x41;
    raw[12] = '$';
    raw[13] = '1';
    raw[14] = ':';
    raw[15] = '$';
    raw[16] = 0x42;
    raw[17] = '1';
    raw[18] = ')';
    raw[0] = 18;
    store.write(3, 41);
    test6502.expectEqualBool(21, true, matches(41, 2, 24));

    // =SUM(A1*3)*2
    put(42, '=', 0x53, 0x55, 0x4d, '(', 0x41, '1', '*', '3', ')');
    raw[11] = '*';
    raw[12] = '2';
    raw[0] = 12;
    store.write(3, 42);
    test6502.expectEqualBool(24, true, matches(42, 2, 24));

    // =AVG(SUM(2+3))
    put(43, '=', 0x41, 0x56, 0x47, '(', 0x53, 0x55, 0x4d, '(', '2');
    raw[11] = '+';
    raw[12] = '3';
    raw[13] = ')';
    raw[14] = ')';
    raw[0] = 14;
    store.write(3, 43);
    test6502.expectEqualBool(25, true, matches(43, 2, 5));

    // =COUNT(2*3)
    put(44, '=', 0x43, 0x4f, 0x55, 0x4e, 0x54, '(', '2', '*', '3');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 44);
    test6502.expectEqualBool(26, true, matches(44, 2, 1));

    // =A4+" X" and =B4+"!" exercise chained text, including the REU cache.
    put(48, 0x4c, 0x41, 0x42, 0, 0, 0, 0, 0, 0, 0);
    put(49, '=', 0x41, '4', '+', '"', ' ', 0x58, '"', 0, 0);
    put(50, '=', 0x42, '4', '+', '"', '!', '"', 0, 0, 0);
    calc.evaluate(3, 50);
    results.loadResult(3, 50);
    test6502.expectEqualU8(27, 13, results.state());
    results.text(50, 0, 0xc5, 0x91);
    test6502.expectMemU8(28, 0xc500, 6);
    test6502.expectMemU8(29, 0xc501, 0x4c);
    test6502.expectMemU8(30, 0xc504, 32);
    test6502.expectMemU8(31, 0xc506, 0x21);

    // A blank reference contributes an empty string when joined with text.
    put(51, '=', 0x50, '5', '+', 0x43, '4', 0, 0, 0, 0);
    calc.evaluate(3, 51);
    results.text(51, 0, 0xc5, 0x91);
    test6502.expectMemU8(32, 0xc500, 6);

    // Compound text is ignored by range aggregates, including after edits.
    put(53, '=', 0x53, 0x55, 0x4d, '(', 0x42, '4', ':', 0x43, '4');
    raw[11] = ')';
    raw[0] = 11;
    store.write(3, 53);
    test6502.expectEqualBool(33, true, matches(53, 2, 0));
    put(48, 0x51, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    store.invalidate(3);
    calc.evaluate(3, 50);
    results.text(50, 0, 0xc5, 0x91);
    test6502.expectMemU8(34, 0xc500, 4);
    test6502.expectMemU8(35, 0xc501, 0x51);

    // G4 reaches the 14-byte result limit; H4 overflows it.
    put(54, '=', '"', 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48);
    raw[11] = 0x49;
    raw[12] = 0x4a;
    raw[13] = 0x4b;
    raw[14] = 0x4c;
    raw[15] = 0x4d;
    raw[16] = 0x4e;
    raw[17] = '"';
    raw[0] = 17;
    store.write(3, 54);
    put(55, '=', 0x47, '4', '+', '"', '!', '"', 0, 0, 0);
    test6502.expectEqualBool(36, true, matches(54, 13, 0));
    test6502.expectEqualBool(37, true, matches(55, 14, 0));

    const columns: [*]volatile u8 = @ptrFromInt(0xc310);
    columns[0] = 0xa1;
    store.invalidate(3);
    test6502.expectEqualBool(22, true, matches(0, 3, 0));
    put(52, '=', 0x41, '1', '*', '3', 0, 0, 0, 0, 0);
    test6502.expectEqualBool(23, true, matches(52, 8, 0));
    columns[0] = 0;
    test6502.pass();
}
