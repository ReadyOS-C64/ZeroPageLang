const test6502 = @import("test6502");
const first = [_]u8{85, 84, 87, 86, 81, 80, 83, 82, 93, 92, 95, 94, 89, 88, 91, 90, 69, 68, 71, 70, 65, 64, 67, 66, 77, 76, 79, 78, 73, 72, 75, 74, 117, 116, 119, 118, 113, 112, 115, 114, 125, 124, 127, 126, 121, 120, 123, 122, 101, 100, 103, 102, 97, 96, 99, 98, 109, 108, 111, 110, 105, 104, 107, 106, 21, 20, 23, 22, 17, 16, 19, 18, 29, 28, 31, 30, 25, 24, 27, 26, 5, 4, 7, 6, 1, 0, 3, 2, 13, 12, 15, 14, 9, 8, 11, 10, 53, 52, 55, 54, 49, 48, 51, 50, 61, 60, 63, 62, 57, 56, 59, 58, 37, 36, 39, 38, 33, 32, 35, 34, 45, 44, 47, 46, 41, 40, 43, 42};
const second = [_]u8{3, 20, 37, 54, 71, 88, 105, 122, 139, 156, 173, 190, 207, 224, 241, 2, 19, 36, 53, 70, 87, 104, 121, 138, 155, 172, 189, 206, 223, 240, 1, 18, 35, 52, 69, 86, 103, 120, 137, 154, 171, 188, 205, 222, 239, 0, 17, 34, 51, 68, 85, 102, 119, 136, 153, 170, 187, 204, 221, 238, 255, 16, 33, 50, 67, 84, 101, 118, 135, 152, 169, 186, 203, 220, 237, 254, 15, 32, 49, 66, 83, 100, 117, 134, 151, 168, 185, 202, 219, 236, 253, 14, 31, 48, 65, 82, 99, 116, 133, 150, 167, 184, 201, 218, 235, 252, 13, 30, 47, 64, 81, 98, 115, 132, 149, 166, 183, 200, 217, 234, 251, 12, 29, 46, 63, 80, 97, 114};
const third = [_]u8{255, 254, 253, 252, 251, 250, 249, 248, 247, 246, 245, 244, 243, 242, 241, 240, 239, 238, 237, 236, 235, 234, 233, 232, 231, 230, 229, 228, 227, 226, 225, 224, 223, 222, 221, 220, 219, 218, 217, 216, 215, 214, 213, 212, 211, 210, 209, 208, 207, 206, 205, 204, 203, 202, 201, 200, 199, 198, 197, 196, 195, 194, 193, 192, 191, 190, 189, 188, 187, 186, 185, 184, 183, 182, 181, 180, 179, 178, 177, 176, 175, 174, 173, 172, 171, 170, 169, 168, 167, 166, 165, 164, 163, 162, 161, 160, 159, 158, 157, 156, 155, 154, 153, 152, 151, 150, 149, 148, 147, 146, 145, 144, 143, 142, 141, 140, 139, 138, 137, 136, 135, 134, 133, 132, 131, 130, 129, 128};

fn gather(index: u8) u16 {
    const i: u8 = index & 127;
    const a: u8 = first[i];
    const b: u8 = second[i];
    const c: u8 = third[i];
    return @as(u16, a) + @as(u16, b) + @as(u16, c);
}
fn reverse(index: u8, other: u8) u16 {
    const i: u8 = index & 127;
    const j: u8 = other & 127;
    const a: u8 = first[i];
    const b: u8 = second[j];
    const c: u8 = third[i];
    return @as(u16, a) + @as(u16, b) + @as(u16, c);
}
fn mutate(index: u8) u16 {
    var i: u8 = index & 127;
    const a: u8 = first[i];
    i = (i + 1) & 127;
    const b: u8 = second[i];
    return @as(u16, a) + @as(u16, b);
}
fn store(index: u8, location: *u8) u16 {
    const i: u8 = index & 127;
    const a: u8 = first[i];
    location.* = a;
    const b: u8 = second[i];
    return @as(u16, a) + @as(u16, b);
}
fn branch(index: u8) u16 {
    const i: u8 = index & 127;
    const a: u8 = first[i];
    if (a < 64) { return second[i]; }
    return @as(u16, a) + @as(u16, third[i]);
}
fn bump(value: u8) u8 { return value + 1; }
fn callBarrier(index: u8) u16 {
    const i: u8 = index & 127;
    const a: u8 = first[i];
    const b: u8 = second[bump(index) & 127];
    const c: u8 = third[i];
    return @as(u16, a) + @as(u16, b) + @as(u16, c);
}
fn volatileReads(index: u8, location: *volatile u8) u16 {
    const i: u8 = index & 127;
    const a: u8 = first[i];
    const tick1: u8 = location.*;
    const b: u8 = second[i];
    const tick2: u8 = location.*;
    return @as(u16, a) + @as(u16, b) + @as(u16, tick1) + @as(u16, tick2);
}
export fn main() void {
    test6502.expectEqualU16(1, 343, gather(0));
    test6502.expectEqualU16(2, 284, gather(255));
    test6502.expectEqualU16(3, 454, reverse(0, 255));
    test6502.expectEqualU16(4, 45, mutate(255));
    const location: *u8 = @ptrFromInt(0xc100);
    test6502.expectEqualU16(5, 88, store(0, location));
    test6502.expectEqualU8(6, 85, location.*);
    test6502.expectEqualU16(7, 340, branch(0));
    test6502.expectEqualU16(8, 360, callBarrier(0));
    const timer: *volatile u8 = @ptrFromInt(0xdc04);
    test6502.expectEqualU16(9, 91, volatileReads(0, timer));
    test6502.pass();
}
