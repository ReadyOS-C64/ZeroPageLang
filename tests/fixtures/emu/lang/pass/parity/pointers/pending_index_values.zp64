const test6502 = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .recursiveIndex = .{ .frame = .stack } } },
};

const Holder = struct { pad: u8, value: u16 };
const Words = struct { values: [2]u16 };
const Index = struct { value: u8 };

fn choose(a: u16, b: u16) u8 {
    const probe: *volatile u16 = @ptrFromInt(0xc300);
    if (probe.* != 7) { return 1; }
    if (a == b + 1) { return 0; }
    return 1;
}

fn ordinary(value: u16) u16 {
    var items = [_]u16{ 0x1122, 0x3344 };
    items[choose(2, 1)] = value;
    return items[0];
}

fn field(value: u16) u16 {
    var items = [_]Holder{ Holder{ .pad = 1, .value = 0x1122 }, Holder{ .pad = 2, .value = 0x3344 } };
    items[choose(2, 1)].value = value;
    return items[0].value;
}

fn pointerStruct(value: u16) u16 {
    var holder = Words{ .values = [_]u16{ 0x1122, 0x3344 } };
    const ptr: *Words = &holder;
    ptr.values[choose(2, 1)] = value;
    return holder.values[0];
}

fn many(value: u16) u16 {
    const ptr: [*]u16 = @ptrFromInt(0xc100);
    ptr[choose(2, 1)] = value;
    return ptr[0];
}

fn readByte() u8 {
    const ptr: [*]u8 = @ptrFromInt(0xc100);
    return ptr[choose(2, 1)];
}

fn readWord() u16 {
    const ptr: [*]u16 = @ptrFromInt(0xc100);
    return ptr[choose(2, 1)];
}

fn storeByte(value: u8) u8 {
    const ptr: [*]u8 = @ptrFromInt(0xc100);
    ptr[choose(2, 1)] = value;
    return ptr[0];
}

fn fieldIndex(value: u16, index: u8) u16 {
    var selected = Index{ .value = index };
    const ip: *Index = &selected;
    const ptr: [*]u16 = @ptrFromInt(0xc100);
    ptr[ip.value] = value;
    return ptr[index];
}

fn nestedChoose() u8 {
    var values = [_]u16{ 0, 0 };
    values[choose(2, 1)] = 0x1234;
    if (values[0] == 0x1234) { return 0; }
    return 1;
}

fn nested(value: u16) u16 {
    var values = [_]u16{ 0, 0 };
    values[nestedChoose()] = value;
    return values[0];
}

fn arithmetic(value: u16, index: u8, other: u8) u16 {
    var values = [_]u16{ 0, 0 };
    values[index + other] = value;
    return values[index + other];
}

fn recursiveIndex(depth: u8) u8 {
    if (depth == 0) { return 0; }
    return recursiveIndex(depth - 1);
}

fn recursiveHelper(value: u16) u16 {
    const ptr: [*]u16 = @ptrFromInt(0xc100);
    ptr[recursiveIndex(5)] = value;
    return ptr[0];
}

export fn main() void {
    const probe: *u16 = @ptrFromInt(0xc300);
    probe.* = 7;
    test6502.expectEqualU16(1, 0xc1f0, ordinary(0xc1f0));
    test6502.expectEqualU16(2, 0xc1f0, field(0xc1f0));
    test6502.expectEqualU16(3, 0xc1f0, pointerStruct(0xc1f0));
    test6502.expectEqualU16(4, 0xc1f0, many(0xc1f0));
    test6502.expectEqualU8(5, 0xf0, readByte());
    test6502.expectEqualU16(6, 0xc1f0, readWord());
    test6502.expectEqualU8(7, 0x5a, storeByte(0x5a));
    test6502.expectEqualU16(8, 0x1234, fieldIndex(0x1234, 1));
    test6502.expectEqualU16(9, 0xc1f0, nested(0xc1f0));
    test6502.expectEqualU16(10, 0xc1f0, arithmetic(0xc1f0, 0, 1));
    test6502.expectEqualU16(11, 0xabcd, recursiveHelper(0xabcd));
    test6502.pass();
}
