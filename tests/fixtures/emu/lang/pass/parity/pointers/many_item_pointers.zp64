const test6502 = @import("test6502");

const Cell = enum(u8) { empty = 0, x = 1, o = 2 };

fn byteAt(ptr: [*]u8, index: u8) u8 {
    return ptr[index];
}

fn putByte(ptr: [*]u8, index: u8, value: u8) void {
    ptr[index] = value;
}

fn wordAt(ptr: [*]u16, index: u8) u16 {
    return ptr[index];
}

fn putWord(ptr: [*]u16, index: u8, value: u16) void {
    ptr[index] = value;
}

fn passBytes(ptr: [*]u8) [*]u8 {
    return ptr;
}

fn firstCell(ptr: [*]Cell) Cell {
    return ptr[0];
}

fn chooseCell(ptr: [*]Cell, index: u8) Cell {
    return switch (ptr[index]) {
        Cell.x => .o,
        Cell.o => .x,
        else => .empty,
    };
}

export fn main() void {
    var bytes = [_]u8{ 1, 2, 3, 4 };
    var bools = [_]bool{ false, true, false };
    var signed_bytes = [_]i8{ 1, 0xfe, 3 };
    var cells = [_]Cell{ .empty, .x, .o };
    var words = [_]u16{ 0x0102, 0x0304, 0x0506 };
    var sizes = [_]usize{ 0x1000, 0x2000, 0x3000 };

    const byte_ptr: [*]u8 = @ptrFromInt(@intFromPtr(&bytes[0]));
    const bool_ptr: [*]bool = @ptrFromInt(@intFromPtr(&bools[0]));
    const signed_ptr: [*]i8 = @ptrFromInt(@intFromPtr(&signed_bytes[0]));
    const cell_ptr: [*]Cell = @ptrFromInt(@intFromPtr(&cells[0]));
    const word_ptr: [*]u16 = @ptrFromInt(@intFromPtr(&words[0]));
    const size_ptr: [*]usize = @ptrFromInt(@intFromPtr(&sizes[0]));

    test6502.expectEqualU8(1, 1, byte_ptr[0]);
    test6502.expectEqualU8(2, 3, byteAt(byte_ptr, 2));
    test6502.expectEqualBool(3, true, bool_ptr[1]);
    test6502.expectEqualI8(4, 0xfe, signed_ptr[1]);
    test6502.expectEqualU8(5, 0, firstCell(cell_ptr));
    test6502.expectEqualU16(6, 0x0304, wordAt(word_ptr, 1));
    test6502.expectEqualU16(7, 0x3000, size_ptr[2]);

    putByte(byte_ptr, 1, 9);
    byte_ptr[2] += 5;
    byte_ptr[3] *= 3;
    byte_ptr[0] |= 0x80;
    byte_ptr[0] &= 0x8f;
    byte_ptr[0] ^= 0x01;
    byte_ptr[1] <<= 1;
    byte_ptr[1] >>= 1;

    test6502.expectEqualU8(8, 0x80, bytes[0]);
    test6502.expectEqualU8(9, 9, bytes[1]);
    test6502.expectEqualU8(10, 8, bytes[2]);
    test6502.expectEqualU8(11, 12, bytes[3]);

    bool_ptr[0] = true;
    signed_ptr[2] = 0xfd;
    cell_ptr[1] = .o;
    putWord(word_ptr, 2, 0x0a0b);
    word_ptr[0] += 0x0101;
    word_ptr[1] <<= 1;
    size_ptr[0] = size_ptr[1] + 3;

    test6502.expectEqualBool(12, true, bools[0]);
    test6502.expectEqualI8(13, 0xfd, signed_bytes[2]);
    test6502.expectEqualU8(14, 2, cells[1]);
    test6502.expectEqualU16(15, 0x0203, words[0]);
    test6502.expectEqualU16(16, 0x0608, words[1]);
    test6502.expectEqualU16(17, 0x0a0b, words[2]);
    test6502.expectEqualU16(18, 0x2003, sizes[0]);

    const idx: u8 = 2;
    test6502.expectEqualU16(19, 0x0a0b, word_ptr[idx]);
    test6502.expectEqualU8(20, 1, chooseCell(cell_ptr, 2));

    const returned = passBytes(byte_ptr);
    returned[2] = if (bool_ptr[0]) 0x2a else 0;
    test6502.expectEqualU8(21, 0x2a, bytes[2]);

    const block_value: u8 = blk: {
        returned[3] += 1;
        break :blk returned[3];
    };
    test6502.expectEqualU8(22, 13, block_value);

    var sum: u8 = 0;
    for (0..bytes.len) |i| {
        sum += returned[i];
    }
    test6502.expectEqualU8(23, 192, sum);
    test6502.expectEqualU16(24, 0, @intFromPtr(byte_ptr) - @intFromPtr(byte_ptr));
}
