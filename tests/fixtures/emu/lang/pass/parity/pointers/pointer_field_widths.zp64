const test6502 = @import("ZeroPage");

const Holder = struct { pad: u8, ptr: *u8 };
const MaybeHolder = struct { ptr: ?*u8 };

fn make(ptr: *u8) Holder {
    return Holder{ .pad = 3, .ptr = ptr };
}

fn makeBlock(ptr: *u8) Holder {
    return Holder{ .pad = 7, .ptr = blk: { break :blk ptr; } };
}

fn read(holder: Holder) *u8 {
    return holder.ptr;
}

fn readIndirect(holder: *Holder) *u8 {
    return holder.ptr;
}

fn choose(a: u16, b: u16) u8 {
    if (a == b + 1) { return 0; }
    return 1;
}

fn storeIndexed(ptr: *u8, value: *u8) *u8 {
    var items = [_]Holder{ Holder{ .pad = 1, .ptr = ptr }, Holder{ .pad = 2, .ptr = ptr } };
    items[choose(2, 1)].ptr = value;
    return items[0].ptr;
}

fn wrap(ptr: ?*u8) MaybeHolder {
    return MaybeHolder{ .ptr = ptr };
}

export fn main() void {
    const ptr: *u8 = @ptrFromInt(0xc150);
    const value: *u8 = @ptrFromInt(0xc1f0);
    var holder: Holder = make(ptr);
    test6502.expectEqualU16(1, 0xc150, @intFromPtr(read(holder)));
    const through: *Holder = &holder;
    test6502.expectEqualU16(2, 0xc150, @intFromPtr(readIndirect(through)));
    holder.ptr = value;
    test6502.expectEqualU16(3, 0xc1f0, @intFromPtr(read(holder)));
    const blocked: Holder = makeBlock(ptr);
    test6502.expectEqualU16(4, 0xc150, @intFromPtr(read(blocked)));
    test6502.expectEqualU16(5, 0xc1f0, @intFromPtr(storeIndexed(ptr, value)));
    const maybe: ?*u8 = value;
    const wrapped: MaybeHolder = wrap(maybe);
    test6502.expectSomePtr(6, 0xc1f0, wrapped.ptr);
    test6502.pass();
}
