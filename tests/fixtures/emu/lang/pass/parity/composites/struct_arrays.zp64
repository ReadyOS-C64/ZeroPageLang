const test6502 = @import("test6502");

const Cell = enum(u8) { empty = 0, x = 1, o = 2 };
const Point = struct { x: u8, y: u8 };
const WordPoint = struct { x: u16, y: u16 };
const Move = struct { cell: Cell, pos: u8, score: u16 };
const NestedPoint = struct { pos: Point, weight: u8 };

const const_points = [_]Point{
    Point{ .x = 1, .y = 2 },
    Point{ .x = 3, .y = 4 },
    Point{ .x = 5, .y = 6 },
};

const const_moves = [_]Move{
    Move{ .cell = .empty, .pos = 0, .score = 10 },
    Move{ .cell = .x, .pos = 4, .score = 200 },
    Move{ .cell = .o, .pos = 8, .score = 511 },
};

fn pointScore(index: u8) u8 {
    return const_points[index].x + const_points[index].y;
}

fn moveCell(index: u8) Cell {
    return const_moves[index].cell;
}

fn moveScore(index: u8) u16 {
    return const_moves[index].score;
}

export fn main() void {
    test6502.expectEqualU16(1, 3, const_points.len);
    test6502.expectEqualU8(2, 1, const_points[0].x);
    test6502.expectEqualU8(3, 4, const_points[1].y);
    test6502.expectEqualU8(4, 11, pointScore(2));
    test6502.expectEqualU8(5, 1, moveCell(1));
    test6502.expectEqualU16(6, 511, moveScore(2));

    var points: [3]Point = .{
        Point{ .x = 10, .y = 20 },
        Point{ .x = 30, .y = 40 },
        Point{ .x = 50, .y = 60 },
    };
    var idx: u8 = 1;
    test6502.expectEqualU8(7, 30, points[idx].x);
    points[idx].y = points[0].x + 5;
    test6502.expectEqualU8(8, 15, points[1].y);

    points[2].x = const_points[idx].y;
    test6502.expectEqualU8(9, 4, points[2].x);

    var words: [2]WordPoint = .{
        WordPoint{ .x = 256, .y = 511 },
        WordPoint{ .x = 1024, .y = 2048 },
    };
    words[idx].x = words[0].y + 1;
    test6502.expectEqualU16(10, 512, words[1].x);
    test6502.expectEqualU16(11, 2048, words[1].y);

    var moves: [3]Move = .{
        Move{ .cell = .empty, .pos = 0, .score = 0 },
        Move{ .cell = .empty, .pos = 0, .score = 0 },
        Move{ .cell = .empty, .pos = 0, .score = 0 },
    };
    moves[0].cell = .x;
    moves[0].pos = 4;
    moves[0].score = 100;
    moves[1].cell = .o;
    moves[1].pos = const_moves[2].pos;
    moves[1].score = const_moves[1].score + 1;
    test6502.expectEqualU8(12, 1, moves[0].cell);
    test6502.expectEqualU8(13, 4, moves[0].pos);
    test6502.expectEqualU16(14, 100, moves[0].score);
    test6502.expectEqualU8(15, 2, moves[1].cell);
    test6502.expectEqualU8(16, 8, moves[1].pos);
    test6502.expectEqualU16(17, 201, moves[1].score);

    var total: u8 = 0;
    for (points, 0..) |_, i| {
        total += points[i].x;
    }
    test6502.expectEqualU8(18, 44, total);

    var nested: [2]NestedPoint = .{
        NestedPoint{ .pos = Point{ .x = 7, .y = 8 }, .weight = 9 },
        NestedPoint{ .pos = Point{ .x = 10, .y = 11 }, .weight = 12 },
    };
    nested[idx].pos.x = points[1].y;
    test6502.expectEqualU8(19, 15, nested[1].pos.x);
    test6502.expectEqualU8(20, 11, nested[1].pos.y);
    test6502.expectEqualU8(21, 12, nested[1].weight);

    test6502.pass();
}
