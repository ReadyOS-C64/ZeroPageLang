const test6502 = @import("test6502");

fn stmtCapture(value: u8) u8 {
    var result: u8 = 0;
    switch (value) {
        1 => |payload| {
            result = payload + 2;
        },
        2, 3 => |payload2| {
            result = payload2 + 4;
        },
        else => |fallback| {
            result = fallback;
        },
    }
    return result;
}

fn exprCapture(value: u16) u16 {
    return switch (value) {
        1 => |payload| payload + 9,
        2...4 => |range_payload| range_payload + 10,
        else => |fallback| fallback + 1,
    };
}

export fn main() void {
    test6502.expectEqualU8(1, 3, stmtCapture(1));
    test6502.expectEqualU8(2, 7, stmtCapture(3));
    test6502.expectEqualU8(3, 9, stmtCapture(9));
    test6502.expectEqualU16(4, 10, exprCapture(1));
    test6502.expectEqualU16(5, 14, exprCapture(4));
    test6502.expectEqualU16(6, 12, exprCapture(11));
    const nested: u8 = switch (stmtCapture(1)) {
        3 => |payload3| payload3 + 1,
        else => 0,
    };
    test6502.expectEqualU8(7, 4, nested);
    test6502.pass();
}
