const test6502 = @import("test6502");

fn add(a: u8, b: u8) u8 {
    return a + b;
}

fn sub(a: u8, b: u8) u8 {
    return a - b;
}

fn same(a: u8, b: u8) bool {
    return a == b;
}

export fn main() void {
    test6502.expectEqualU8(1, 3, 1 + 2);
    test6502.expectEqualU8(2, 9, 12 - 3);
    test6502.expectEqualBool(3, true, 4 == 4);
    test6502.expectEqualBool(4, false, 4 == 5);
    var x: u8 = 7;
    test6502.expectEqualU8(5, 10, x + 3);
    test6502.expectEqualU8(6, 4, x - 3);
    test6502.expectEqualBool(7, true, x == 7);
    test6502.expectEqualU8(8, 6, add(1, 5));
    test6502.expectEqualU8(9, 6, add(add(1, 2), 3));
    test6502.expectEqualU8(10, 6, add(1, add(2, 3)));
    test6502.expectEqualU8(11, 10, add(add(1, 2), add(3, 4)));
    test6502.expectEqualU8(12, 5, sub(add(3, 4), 2));
    test6502.expectEqualBool(13, true, same(add(1, 2), 3));
    test6502.expectEqualBool(14, false, same(sub(8, 3), 4));
    test6502.pass();
}
