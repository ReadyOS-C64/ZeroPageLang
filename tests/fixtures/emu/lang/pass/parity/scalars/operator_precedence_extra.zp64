const test6502 = @import("test6502");

fn returnBool(value: bool) bool {
    return value;
}

fn addWide(a: u16, b: u16) u16 {
    return a + b;
}

fn sideEffect(value: u8) u8 {
    test6502.hit(900);
    return value + 1;
}

fn ignoredWord() u16 {
    test6502.hit(901);
    return 1024;
}

fn chooseByte(flag: bool, a: u8, b: u8) u8 {
    return if (flag) a else b;
}

fn blockWord(a: u16, b: u16) u16 {
    return blk: {
        const sum = a + b;
        if (sum == 513) {
            break :blk sum;
        }
        break :blk 0;
    };
}

export fn main() void {
    test6502.expectEqualBool(1, false, false or false or false);
    test6502.expectEqualBool(2, false, true and true and false);
    test6502.expectEqualU8(3, 7, 1 | 2 | 4);
    test6502.expectEqualU8(4, 13, 3 ^ 6 ^ 8);
    test6502.expectEqualU8(5, 4, 7 & 14 & 28);
    test6502.expectEqualU8(6, 72, 9 << 1 << 2);
    test6502.expectEqualU8(7, 11, 90 >> 1 >> 2);
    test6502.expectEqualU16(8, 1099, 100 - 1 + 1000);
    test6502.expectEqualU8(9, 255, 15 * 17);
    test6502.expectEqualBool(10, true, !!returnBool(true));

    const wide = addWide(256, 257);
    test6502.expectEqualU16(11, 513, wide);
    test6502.expectEqualU16(12, 513, blockWord(256, 257));
    test6502.expectEqualU8(13, 9, chooseByte(returnBool(true), 9, 1));
    test6502.expectEqualU8(14, 1, chooseByte(returnBool(false), 9, 1));

    _ = sideEffect(4);
    _ = ignoredWord();
    test6502.expectHitCount(900, 1);
    test6502.expectHitCount(901, 1);

    var value = 3;
    value = if (returnBool(value == 3)) blk: {
        const next = value + 4;
        break :blk next;
    } else 0;
    test6502.expectEqualU8(15, 7, value);

    var mask: u16 = 61680;
    mask &= 4080;
    mask |= 15;
    mask ^= 255;
    test6502.expectEqualU16(16, 0, mask);

    test6502.pass();
}
