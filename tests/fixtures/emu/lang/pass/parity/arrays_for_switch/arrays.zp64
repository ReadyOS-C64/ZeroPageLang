const test6502 = @import("test6502");

const table = [_]u8{ 3, 5, 7, 9 };
const flags = [_]bool{ true, false, true };
const signed_bytes = [_]i8{ 255, 128, 1 };
const words = [_]u16{ 256, 511, 1024 };
const signed_words = [_]i16{ 65535, 32768, 12 };
const positions = [_]usize{ 0, 1, 2 };

fn lookupByte(index: u8) u8 {
    return table[index];
}

fn lookupWord(index: u8) u16 {
    return words[index];
}

fn sumArgs(a: u8, b: u8) u8 {
    return a + b;
}

fn chooseFromArray(ok: bool) u8 {
    return if (ok) table[0] else table[1];
}

fn blockLookup(index: u8) u8 {
    return blk: {
        break :blk table[index];
    };
}

export fn main() void {
    test6502.expectEqualU8(1, 3, table[0]);
    test6502.expectEqualU8(2, 7, table[2]);
    test6502.expectEqualBool(3, true, flags[0]);
    test6502.expectEqualBool(4, false, flags[1]);
    test6502.expectEqualI8(5, 255, signed_bytes[0]);
    test6502.expectEqualI8(6, 128, signed_bytes[1]);
    test6502.expectEqualU16(7, 1024, words[2]);
    test6502.expectEqualU16(8, 65535, signed_words[0]);
    test6502.expectEqualU16(9, 32768, signed_words[1]);
    test6502.expectEqualU16(10, 4, table.len);
    test6502.expectEqualU16(11, 3, flags.len);
    test6502.expectEqualU16(12, 3, positions.len);

    var bytes: [4]u8 = .{ 1, 2, 3, 4 };
    bytes[0] = table[2];
    bytes[1] += 3;
    bytes[2] -= 1;
    bytes[3] *= 4;
    bytes[0] &= 6;
    bytes[1] |= 16;
    bytes[2] ^= 7;
    bytes[3] <<= 1;
    bytes[3] >>= 2;
    test6502.expectEqualU8(13, 6, bytes[0]);
    test6502.expectEqualU8(14, 21, bytes[1]);
    test6502.expectEqualU8(15, 5, bytes[2]);
    test6502.expectEqualU8(16, 8, bytes[3]);
    test6502.expectEqualU16(17, 4, bytes.len);

    var idx: u8 = 1;
    bytes[idx] = 9;
    test6502.expectEqualU8(18, 9, bytes[1]);
    test6502.expectEqualU8(19, 5, lookupByte(idx));
    test6502.expectEqualU8(20, 12, sumArgs(table[0], bytes[1]));

    var ws: [3]u16 = .{ 1, 256, 511 };
    ws[0] = words[2];
    ws[1] += 255;
    ws[2] *= 2;
    ws[1] &= 511;
    ws[2] >>= 1;
    test6502.expectEqualU16(21, 1024, ws[0]);
    test6502.expectEqualU16(22, 511, ws[1]);
    test6502.expectEqualU16(23, 511, ws[2]);

    var wi: u8 = 1;
    ws[wi] = lookupWord(0) + 1;
    test6502.expectEqualU16(24, 257, ws[1]);
    test6502.expectEqualU16(25, 1, positions[wi]);

    var bools: [3]bool = .{ false, true, false };
    bools[0] = flags[0] and !flags[1];
    bools[2] = bools[0] and flags[2];
    test6502.expectEqualBool(26, true, bools[0]);
    test6502.expectEqualBool(27, true, bools[2]);

    var signed_local: [2]i8 = .{ 255, 128 };
    signed_local[1] = signed_bytes[2];
    test6502.expectEqualI8(28, 255, signed_local[0]);
    test6502.expectEqualI8(29, 1, signed_local[1]);

    var signed_word_local: [2]i16 = .{ 65535, 32768 };
    signed_word_local[1] = signed_words[2];
    test6502.expectEqualU16(30, 65535, signed_word_local[0]);
    test6502.expectEqualU16(31, 12, signed_word_local[1]);

    const explicit: [3]u8 = .{ 10, 20, 30 };
    test6502.expectEqualU8(32, 20, explicit[1]);
    test6502.expectEqualU8(33, 3, chooseFromArray(true));
    test6502.expectEqualU8(34, 5, chooseFromArray(false));
    test6502.expectEqualU8(35, 7, blockLookup(2));
    test6502.expectEqualU8(36, 9, if (flags[2]) bytes[1] else 0);

    test6502.pass();
}
