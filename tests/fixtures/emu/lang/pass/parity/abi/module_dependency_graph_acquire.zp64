// zeropage-emu-module: filename=mathcore source=tests/fixtures/emu/modules/math_core_dispatch.zp64
// zeropage-emu-module: filename=fixedmath source=tests/fixtures/emu/modules/fixed_math_runtime.zp64
// zeropage-emu-label-memory: zeropage_module_registry_row1_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row1_refcount=$02
// zeropage-emu-label-memory: zeropage_module_registry_row2_loaded=$00
// zeropage-emu-label-memory: zeropage_module_registry_row3_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row3_refcount=$02
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$01
// zeropage-emu-reu: $030800=$4c
// zeropage-emu-reu: $031800=$4c
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

const MathCore = ZeroPage.module.import(.math_core, .{
    .add = fn (u8) u8,
});

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x002000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 4 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{
                .math_core = "mathcore",
                .pathing = "pathing",
                .fixed_math = "fixedmath",
            },
        },
        .dependency_graph = .{
            .math_core = .{ .deps = .{ .fixed_math } },
            .pathing = .{ .deps = .{} },
            .fixed_math = .{ .deps = .{} },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_graph_acquire",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core", "pathing" },
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, true, ZeroPage.module.acquireDependencyGraph("math_core"));
    test6502.expectEqualBool(2, true, ZeroPage.module.acquireDependencyGraph("math_core"));
    test6502.expectEqualBool(3, true, ZeroPage.module.isLoaded("fixed_math"));
    test6502.expectEqualBool(4, true, ZeroPage.module.isLoaded("math_core"));
    if (MathCore.add(3)) |value| {
        test6502.expectEqualU8(5, 5, value);
    } else {
        test6502.fail(6);
    }
    test6502.expectMemU8(7, 0xc000, 0x4c);
    test6502.expectMemU8(8, 0xc091, 0x0c);
    test6502.pass();
}
