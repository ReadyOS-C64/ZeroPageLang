const test6502 = @import("test6502");

memory {
    region sprites_ram: c64 at 0x9200 size 0x0040;
    region particles_ram: c64 at 0x9300 size 0x0020;
    region arena_ram: c64 at 0x9400 size 0x0020;

    pool sprites in sprites_ram block 16;
    pool particles in particles_ram block 8;
    arena arena in arena_ram;
}

export fn main() void {
    const first = sprites.allocBytes(4);
    test6502.expectSomePtr(1, 0x9200, first);
    if (first) |first_buf| {
        first_buf[0] = 0x41;
        first_buf[15] = 0x4f;
    } else {
        test6502.fail(90);
    }
    test6502.expectMemU8(2, 0x9200, 0x41);
    test6502.expectMemU8(3, 0x920f, 0x4f);

    const second = sprites.allocBytes(16);
    test6502.expectSomePtr(4, 0x9210, second);

    const too_large = sprites.allocBytes(17);
    test6502.expectNull(5, too_large);

    if (first) |free_buf| {
        sprites.free(free_buf);
    }
    const reused = sprites.allocBytes(1);
    test6502.expectSomePtr(6, 0x9200, reused);

    _ = sprites.allocBytes(1);
    _ = sprites.allocBytes(1);
    const exhausted = sprites.allocBytes(1);
    test6502.expectNull(7, exhausted);

    sprites.reset();
    const reset_block = sprites.allocBytes(8);
    test6502.expectSomePtr(8, 0x9200, reset_block);

    var zero_len: u8 = 0;
    const runtime_zero = sprites.allocBytes(zero_len);
    test6502.expectNull(9, runtime_zero);

    const particle = particles.allocBytes(8);
    test6502.expectSomePtr(10, 0x9300, particle);

    const arena = arena.allocBytes(3);
    test6502.expectSomePtr(11, 0x9400, arena);

    test6502.pass();
}
