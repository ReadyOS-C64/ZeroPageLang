const ZeroPage = @import("ZeroPage");
const test6502 = @import("test6502");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x010000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
    },
    .abi = .{
        .functions = .{
            .tick = .{ .frame = .stack },
        },
    },
};

pub const zeropage_module = .{
    .id = "enemy_runtime",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{},
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    const disk_ok = ZeroPage.module.loadFromDisk("enemy_runtime", "enemyrt");
    test6502.expectEqualBool(1, false, disk_ok);
    test6502.expectEqualBool(2, false, ZeroPage.module.isLoaded("enemy_runtime"));
    test6502.expectNull(3, ZeroPage.module.call("enemy_runtime", "tick", .{5}));
    test6502.expectEqualBool(4, true, ZeroPage.module.load("enemy_runtime"));
    test6502.expectSomeU8(5, 6, ZeroPage.module.call("enemy_runtime", "tick", .{5}));
    test6502.pass();
}
