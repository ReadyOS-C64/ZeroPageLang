// zeropage-emu-module: filename=mathcore source=tests/fixtures/emu/modules/math_core_dispatch.zp64
// zeropage-emu-memory: $c000=$4c
// zeropage-emu-reu: $030800=$4c
// zeropage-emu-label-memory: zeropage_module_registry_row1_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row1_refcount=$ff
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$01
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

const MathCore = ZeroPage.module.import(.math_core, .{
    .add = fn (u8) u8,
});

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x001000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 2 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{ .math_core = "mathcore" },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_dep_refcount",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core" },
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, true, ZeroPage.module.loadDependency("math_core"));
    test6502.expectEqualBool(2, true, ZeroPage.module.loadDependency("math_core"));
    test6502.expectEqualBool(20, true, ZeroPage.module.acquireDependency("math_core"));
    ZeroPage.module.unloadDependency("math_core");
    test6502.expectEqualBool(3, true, ZeroPage.module.isLoaded("math_core"));
    test6502.expectSomeU8(4, 5, ZeroPage.module.call("math_core", "add", .{3}));
    ZeroPage.module.unloadDependency("math_core");
    test6502.expectEqualBool(5, false, ZeroPage.module.isLoaded("math_core"));
    test6502.expectNull(6, ZeroPage.module.call("math_core", "add", .{3}));

    test6502.expectEqualBool(7, true, MathCore.load());
    test6502.expectEqualBool(8, true, MathCore.load());
    test6502.expectEqualBool(21, true, MathCore.acquire());
    MathCore.release();
    test6502.expectSomeU8(9, 6, MathCore.add(4));

    var i: u8 = 0;
    while (i < 254) {
        test6502.expectEqualBool(10, true, MathCore.acquire());
        i += 1;
    }
    test6502.expectEqualBool(11, false, MathCore.acquire());
    test6502.expectSomeU8(12, 7, MathCore.add(5));
    test6502.pass();
}
