const test6502 = @import("test6502");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack zp sp 0xf3 fp 0xf5;
}

fn countdown(value: u8) callconv(.stack) u8 {
    if (value == 0) {
        return 5;
    }
    return countdown(value - 1);
}

fn wordCountdown(value: u8) callconv(.stack) u16 {
    if (value == 0) {
        return 0x0105;
    }
    return wordCountdown(value - 1);
}

fn isEven(value: u8) callconv(.stack) bool {
    if (value == 0) {
        return true;
    }
    return isOdd(value - 1);
}

fn isOdd(value: u8) callconv(.stack) bool {
    if (value == 0) {
        return false;
    }
    return isEven(value - 1);
}

export fn main() callconv(.stack) void {
    var down: u8 = countdown(3);
    var word: u16 = wordCountdown(4);
    var even: bool = isEven(6);
    var odd: bool = isOdd(5);

    test6502.expectEqualU8(1, 5, down);
    test6502.expectEqualU16(2, 0x0105, word);
    test6502.expectEqualBool(3, true, even);
    test6502.expectEqualBool(4, true, odd);
}
