// zeropage-emu-module: filename=fixedmath source=tests/fixtures/emu/modules/fixed_math_runtime.zp64
// zeropage-emu-module: filename=pathing source=tests/fixtures/emu/modules/pathing_runtime.zp64
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$02
// zeropage-emu-label-memory: zeropage_module_registry_active_row_aux=$01
// zeropage-emu-memory: $c000=$4c
// zeropage-emu-memory: $6000=$4c
const test6502 = @import("test6502");

extern module Pathing = pathing {
    fn step(value: u8) u8;
}

extern module FixedMath = fixed_math {
    fn bias(value: u8) u8;
}

memory {
    region execution: c64 at 0xc000 size 0x0800;
    region aux_ram: c64 at 0x6000 size 0x0800;
    region frames: c64 at 0xc800 size 0x0400;
    region staging: c64 at 0x9000 size 0x0800;
    region cache: reu at 0x030000 size 0x2000;
    stack in frames;
}

module_loader {
    window main in execution;
    window aux in aux_ram;
    disk_staging in staging;
    reu_cache in cache;
    capacity = 3;

    current {
        file = "session";
    }
    dependency fixed_math {
        file = "fixedmath";
        window = aux;
    }
    dependency pathing {
        file = "pathing";
    }
}

module session abi 1 {
    export tick;
    dependency fixed_math;
    dependency pathing;
}

fn tick(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, true, Pathing.acquire());
    test6502.expectSomeU8(2, 8, Pathing.step(5));

    // This otherwise unused offset tells us if activating aux rewrites main.
    const main_marker: *volatile u8 = @ptrFromInt(0xc400);
    main_marker.* = 0x5a;
    test6502.expectEqualBool(3, true, FixedMath.acquire());
    test6502.expectSomeU8(4, 7, FixedMath.bias(4));
    test6502.expectEqualU8(5, 0x5a, main_marker.*);
    test6502.pass();
}
