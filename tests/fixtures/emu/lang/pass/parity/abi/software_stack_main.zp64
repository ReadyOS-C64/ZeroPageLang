const test6502 = @import("test6502");

memory {
    region call_stack: c64 at 0xc800 size 0x0400;

    stack in call_stack zp sp 0xf3 fp 0xf5;
}

export fn main() callconv(.stack) void {
    var a: u8 = 4;
    var b: u8 = 2;
    var word: u16 = 0x0100;
    var last: u16 = 0;
    var count: u8 = 0;
    var sum: u8 = 0;

    a += 3;
    word += 5;
    if (a > b) {
        a += 1;
    } else {
        a = 0;
    }

    while (count < 3) {
        count += 1;
    }

    for (0..4) |_| {
        sum += 2;
    }
    for (0..4) |i| {
        last = i;
    }

    switch (count) {
        3 => {
            sum += 1;
        },
        else => {
            sum = 0;
        },
    }

    test6502.expectEqualU8(1, 8, a);
    test6502.expectEqualU16(2, 0x0105, word);
    test6502.expectEqualU8(3, 3, count);
    test6502.expectEqualU8(4, 9, sum);
    test6502.expectEqualU16(5, 3, last);
}
