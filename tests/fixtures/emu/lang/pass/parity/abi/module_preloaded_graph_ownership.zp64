// zeropage-emu-start: program_entry
// zeropage-emu-module: filename=mathcore source=tests/fixtures/emu/modules/math_core_dispatch.zp64
// zeropage-emu-module: filename=fixedmath source=tests/fixtures/emu/modules/fixed_math_runtime.zp64
// zeropage-emu-label-memory: zeropage_module_registry_row1_refcount=$00
// zeropage-emu-label-memory: zeropage_module_registry_row3_refcount=$00
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

const MathCore = ZeroPage.module.import(.math_core, .{
    .add = fn (u8) u8,
});

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x002000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 4 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{
                .math_core = "mathcore",
                .pathing = "pathing",
                .fixed_math = "fixedmath",
            },
        },
        .dependency_graph = .{
            .math_core = .{ .deps = .{ .fixed_math } },
            .pathing = .{ .deps = .{} },
            .fixed_math = .{ .deps = .{} },
        },
        .policy = .{
            .current = .{ .mode = .manual },
            .deps = .{
                .math_core = .{ .mode = .preload, .graph = true },
            },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_graph_preload",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core", "pathing" },
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, true, ZeroPage.module.isLoaded("fixed_math"));
    test6502.expectEqualBool(2, true, ZeroPage.module.isLoaded("math_core"));
    test6502.expectEqualBool(3, false, ZeroPage.module.isLoaded("pathing"));
    test6502.expectSomeU8(4, 5, MathCore.add(3));
    test6502.expectEqualBool(5, true, MathCore.acquireGraph());
    MathCore.releaseGraph();
    test6502.expectSomeU8(6, 5, MathCore.add(3));
    MathCore.releaseGraph();
    test6502.expectEqualBool(7, false, ZeroPage.module.isLoaded("fixed_math"));
    test6502.expectNull(8, MathCore.add(3));
    test6502.pass();
}
