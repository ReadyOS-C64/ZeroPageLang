// zeropage-emu-module: filename=mathcore source=tests/fixtures/emu/modules/math_core_dispatch.zp64
// zeropage-emu-module: filename=fixedmath source=tests/fixtures/emu/modules/fixed_math_runtime.zp64
// zeropage-emu-memory: $9000=$4c
// zeropage-emu-memory: $c000=$4c
// zeropage-emu-memory: $c091=$0c
// zeropage-emu-reu: $030800=$4c
// zeropage-emu-reu: $031800=$4c
// zeropage-emu-label-memory: zeropage_module_registry_row1_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row1_refcount=$01
// zeropage-emu-label-memory: zeropage_module_registry_row2_loaded=$00
// zeropage-emu-label-memory: zeropage_module_registry_row3_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row3_refcount=$01
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$01
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

extern module MathCore = math_core {
    fn add(value: u8) u8;
}

memory {
    region call_stack: c64 at 0xc800 size 0x0400;
    region module_window: c64 at 0xc000 size 0x0800;
    region module_cache: reu at 0x030000 size 0x002000;
    region staging_ram: c64 at 0x9000 size 0x0800;

    stack in call_stack;
}

module_loader {
    window main in module_window;
    reu_cache in module_cache;
    disk_staging in staging_ram;
    capacity = 4;
    current {
        file = "enemyrt";
        load = .manual;
    }
    dependency math_core {
        file = "mathcore";
        load = .on_demand;
        graph = true;
        requires = .{.fixed_math};
    }
    dependency pathing {
        file = "pathing";
        requires = .{};
    }
    dependency fixed_math {
        file = "fixedmath";
        requires = .{};
    }
}

module enemy_graph_on_demand abi 1 {
    export tick;
    dependency math_core;
    dependency pathing;
}

fn tick(value: u8) callconv(.stack) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, false, ZeroPage.module.isLoaded("math_core"));
    test6502.expectEqualBool(2, false, ZeroPage.module.isLoaded("fixed_math"));
    test6502.expectSomeU8(3, 5, MathCore.add(3));
    test6502.expectEqualBool(4, true, ZeroPage.module.isLoaded("fixed_math"));
    test6502.expectEqualBool(5, true, ZeroPage.module.isLoaded("math_core"));
    test6502.expectEqualBool(6, false, ZeroPage.module.isLoaded("pathing"));
    test6502.pass();
}
