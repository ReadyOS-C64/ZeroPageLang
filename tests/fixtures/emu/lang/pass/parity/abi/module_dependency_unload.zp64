// zeropage-emu-module: filename=mathcore source=tests/fixtures/emu/modules/math_core_dispatch.zp64
// zeropage-emu-module: filename=pathing source=tests/fixtures/emu/modules/pathing_dispatch.zp64
// zeropage-emu-memory: $c000=$4c
// zeropage-emu-reu: $030800=$4c
// zeropage-emu-reu: $031000=$4c
// zeropage-emu-label-memory: zeropage_module_registry_row1_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_row1_refcount=$01
// zeropage-emu-label-memory: zeropage_module_registry_row2_loaded=$00
// zeropage-emu-label-memory: zeropage_module_registry_row2_refcount=$00
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$01
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x001800 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 3 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{
                .math_core = "mathcore",
                .pathing = "pathing",
            },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_dep_unload",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core", "pathing" },
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    test6502.expectEqualBool(1, true, ZeroPage.module.loadDependency("math_core"));
    test6502.expectSomeU8(2, 5, ZeroPage.module.call("math_core", "add", .{3}));
    ZeroPage.module.unloadDependency("math_core");
    test6502.expectEqualBool(12, false, ZeroPage.module.isLoaded("math_core"));

    test6502.expectEqualBool(4, true, ZeroPage.module.loadDependency("math_core"));
    test6502.expectSomeU8(5, 6, ZeroPage.module.call("math_core", "add", .{4}));
    test6502.expectEqualBool(6, true, ZeroPage.module.loadDependency("pathing"));
    test6502.expectSomeU8(7, 9, ZeroPage.module.call("pathing", "step", .{5}));
    ZeroPage.module.unloadDependency("math_core");
    test6502.expectSomeU8(8, 10, ZeroPage.module.call("pathing", "step", .{6}));
    ZeroPage.module.unloadDependency("pathing");
    test6502.expectNull(9, ZeroPage.module.call("pathing", "step", .{5}));

    test6502.expectEqualBool(10, true, ZeroPage.module.loadDependency("math_core"));
    test6502.expectSomeU8(11, 7, ZeroPage.module.call("math_core", "add", .{5}));
    test6502.pass();
}
