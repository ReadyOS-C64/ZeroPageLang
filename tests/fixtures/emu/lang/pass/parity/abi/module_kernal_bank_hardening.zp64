// zeropage-emu-memory: $e000=$4c
// zeropage-emu-label-memory: zeropage_module_registry_loaded=$00
// zeropage-emu-label-memory: zeropage_module_registry_refcount=$00
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$ff
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xe000, .size = 0x0800, .bank = .ram_under_kernal },
        .reu_cache = .{ .addr = 0x030000, .size = 0x010000 },
    },
    .abi = .{
        .functions = .{
            .color = .{ .frame = .stack },
            .wide = .{ .frame = .stack },
        },
    },
};

pub const zeropage_module = .{
    .id = "enemy_kernal_hardened",
    .abi = 1,
    .flags = .{},
    .exports = .{ .color = color, .wide = wide },
};

fn color(value: u8) u8 {
    return value + 2;
}

fn wide(value: u16) u16 {
    return value + 0x0101;
}

export fn main() void {
    test6502.expectMemU8(1, 0x0001, 0x37);
    test6502.expectEqualBool(2, true, ZeroPage.module.load("enemy_kernal_hardened"));
    test6502.expectMemU8(3, 0x0001, 0x37);
    test6502.expectSomeU8(4, 7, ZeroPage.module.call("enemy_kernal_hardened", "color", .{5}));
    test6502.expectMemU8(5, 0x0001, 0x37);
    test6502.expectSomeU16(6, 0x1335, ZeroPage.module.call("enemy_kernal_hardened", "wide", .{0x1234}));
    test6502.expectMemU8(7, 0x0001, 0x37);
    ZeroPage.module.unload("enemy_kernal_hardened");
    test6502.expectMemU8(8, 0x0001, 0x37);
    test6502.expectNull(9, ZeroPage.module.call("enemy_kernal_hardened", "color", .{5}));
    test6502.expectMemU8(10, 0x0001, 0x37);
    test6502.pass();
}
