// zeropage-emu-disk: enemyrt
// zeropage-emu-memory: $9000=$4c
// zeropage-emu-memory: $c000=$4c
// zeropage-emu-label-memory: zeropage_module_registry_loaded=$01
// zeropage-emu-label-memory: zeropage_module_registry_refcount=$01
// zeropage-emu-label-memory: zeropage_module_registry_active_row=$00
// zeropage-emu-reu: $030000=$4c
const test6502 = @import("test6502");
const ZeroPage = @import("ZeroPage");

const EnemyRuntime = ZeroPage.module.import(.enemy_runtime, .{
    .border = fn (u8) u8,
    .is_five = fn (u8) bool,
    .wide = fn (u16) u16,
});

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x010000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
    },
    .abi = .{
        .functions = .{
            .borderColor = .{ .frame = .stack },
            .isFive = .{ .frame = .stack },
            .wide = .{ .frame = .stack },
        },
    },
};

pub const zeropage_module = .{
    .id = "enemy_runtime",
    .abi = 1,
    .flags = .{},
    .exports = .{ .border = borderColor, .is_five = isFive, .wide = wide },
    .deps = .{},
};

fn borderColor(seed: u8) u8 {
    return seed + 2;
}

fn isFive(value: u8) bool {
    return value == 5;
}

fn wide(value: u16) u16 {
    return value + 0x0101;
}

export fn main() void {
    const before_load = EnemyRuntime.isLoaded();
    test6502.expectEqualBool(1, false, before_load);
    const embedded_load = EnemyRuntime.load();
    test6502.expectEqualBool(2, true, embedded_load);
    const after_load = EnemyRuntime.isLoaded();
    test6502.expectEqualBool(3, true, after_load);
    const first_border = EnemyRuntime.border(3);
    test6502.expectSomeU8(4, 5, first_border);
    EnemyRuntime.unload();
    const after_unload = EnemyRuntime.isLoaded();
    test6502.expectEqualBool(5, false, after_unload);
    const stale_call = EnemyRuntime.border(3);
    test6502.expectNull(6, stale_call);
    const disk_load = EnemyRuntime.loadFromDisk("enemyrt");
    test6502.expectEqualBool(7, true, disk_load);
    const is_five = EnemyRuntime.is_five(5);
    test6502.expectSomeBool(8, true, is_five);
    const wide_value = EnemyRuntime.wide(0x1234);
    test6502.expectSomeU16(9, 0x1335, wide_value);
    test6502.pass();
}
