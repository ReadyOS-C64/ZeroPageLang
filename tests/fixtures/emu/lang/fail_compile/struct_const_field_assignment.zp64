// zeropage-emu-error: immutable local binding cannot be assigned
const test6502 = @import("test6502");

const Cell = enum(u8) { empty, x, o };
const Board = struct { cells: [3]Cell };

export fn main() void {
    const board = Board{ .cells = [_]Cell{ .empty, .empty, .empty } };
    board.cells[0] = .x;
    test6502.expectEqualU8(1, 1, board.cells[0]);
}
