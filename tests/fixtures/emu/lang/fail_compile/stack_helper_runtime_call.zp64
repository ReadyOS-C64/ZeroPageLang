// zeropage-emu-error: unsupported stack frame runtime helper
const c64 = @import("c64");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .worker = .{ .frame = .stack } } },
};

fn worker() u8 {
    return c64.keyboard.readPetscii();
}

export fn main() void {
    _ = worker();
}
