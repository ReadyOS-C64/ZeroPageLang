// zeropage-emu-error: unsupported runtime string variable
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x001000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 2 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{ .math_core = "mathcore" },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_dep_call_fail",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core" },
};

fn tick(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    const name = "add";
    if (ZeroPage.module.call("math_core", name, .{3})) |value| {
        _ = value;
    }
}
