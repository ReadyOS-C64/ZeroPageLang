// zeropage-emu-error: unsupported array size
const ZeroPage = @import("ZeroPage");

const Enemy = struct { hp: u8 };

pub const zeropage_options = .{
    .reu = .{
        .heaps = .{
            .assets = .{ .region = .{ .addr = 0x010000, .size = 0x0200 }, .kind = .arena },
        },
    },
};

export fn main() void {
    const maybe_far = ZeroPage.reu.heap("assets").allocBytes(256);
    if (maybe_far) |far| {
        const enemies = ZeroPage.reu.view(Enemy, far, 256);
        _ = enemies;
    }
}
