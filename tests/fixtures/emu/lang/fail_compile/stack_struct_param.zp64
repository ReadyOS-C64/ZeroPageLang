// zeropage-emu-error: unsupported stack frame aggregate
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .worker = .{ .frame = .stack } } },
};

const Point = struct { x: u8, y: u8 };

fn worker(point: Point) u8 {
    _ = point;
    return 0;
}

export fn main() void {
    _ = worker(Point{ .x = 1, .y = 2 });
}
