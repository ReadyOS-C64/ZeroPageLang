// zeropage-emu-error: UnsupportedZeroPageOptions
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x002000 },
        .disk_staging = .{ .addr = 0x9000, .size = 0x0800 },
        .registry = .{ .capacity = 3 },
        .disk_manifest = .{ .current = "enemyrt", .deps = .{ .math_core = "mathcore", .fixed_math = "fixedmath" } },
        .dependency_graph = .{
            .math_core = .{ .deps = .{ .fixed_math } },
            .fixed_math = .{ .deps = .{} },
        },
        .policy = .{
            .current = .{ .mode = .manual },
            .deps = .{
                .math_core = .{ .mode = .manual, .graph = true },
            },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_bad_policy",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math_core" },
};

fn tick(value: u8) u8 {
    return value;
}

export fn main() void {
    _ = ZeroPage.module.isLoaded("math_core");
}
