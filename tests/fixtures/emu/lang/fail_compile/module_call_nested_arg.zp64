// zeropage-emu-error: unsupported stack frame bridge argument
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x010000 },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_runtime",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{},
};

fn local(value: u8) u8 {
    return value + 1;
}

fn tick(value: u8) u8 {
    return value;
}

export fn main() void {
    const maybe = ZeroPage.module.call("enemy_runtime", "tick", .{local(4)});
    _ = maybe;
}
