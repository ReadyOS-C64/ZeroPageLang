// zeropage-emu-error: valid Zig syntax, but unsupported ZeroPage subset construct
const test6502 = @import("test6502");

export fn main() void {
    var x: u8 = 1;
    label: switch (x) {
        1 => {
            break :label;
        },
        else => {
            test6502.fail(1);
        },
    }
}
