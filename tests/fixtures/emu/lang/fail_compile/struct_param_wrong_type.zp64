// zeropage-emu-error: unsupported struct
const test6502 = @import("test6502");

const Pair = struct { left: u8, right: u8 };
const Point = struct { left: u8, right: u8 };

fn sum(pair: Pair) u8 {
    return pair.left + pair.right;
}

export fn main() void {
    var point = Point{ .left = 1, .right = 2 };
    test6502.expectEqualU8(1, 3, sum(point));
}
