// zeropage-emu-error: unsupported stack frame union
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .worker = .{ .frame = .stack } } },
};

const Event = union(enum) { none, key: u8 };

fn worker() u8 {
    var event: Event = Event{ .key = 1 };
    _ = event;
    return 0;
}

export fn main() void {
    _ = worker();
}
