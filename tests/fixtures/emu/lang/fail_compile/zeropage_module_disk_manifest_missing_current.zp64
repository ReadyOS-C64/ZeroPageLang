// zeropage-emu-error: unsupported zeropage_options metadata
pub const zeropage_options = .{
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x010000 },
        .registry = .{ .capacity = 2 },
        .disk_manifest = .{ .deps = .{ .math_core = "mathcore" } },
    },
};

pub const zeropage_module = .{
    .id = "enemy_manifest",
    .abi = 1,
    .exports = .{ .tick = tick },
    .deps = .{ "math_core" },
};

fn tick(value: u8) u8 {
    return value;
}
