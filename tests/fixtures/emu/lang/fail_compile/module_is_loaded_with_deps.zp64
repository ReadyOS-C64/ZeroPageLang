// zeropage-emu-error: unknown ZeroPage.module id
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .modules = .{
        .load_window = .{ .addr = 0xc000, .size = 0x0800 },
        .reu_cache = .{ .addr = 0x030000, .size = 0x001000 },
        .registry = .{ .capacity = 2 },
        .disk_manifest = .{
            .current = "enemyrt",
            .deps = .{ .math = "math" },
        },
    },
    .abi = .{ .functions = .{ .tick = .{ .frame = .stack } } },
};

pub const zeropage_module = .{
    .id = "enemy_runtime",
    .abi = 1,
    .flags = .{},
    .exports = .{ .tick = tick },
    .deps = .{ "math" },
};

fn tick(value: u8) u8 {
    return value;
}

export fn main() void {
    _ = ZeroPage.module.isLoaded("missing_runtime");
}
