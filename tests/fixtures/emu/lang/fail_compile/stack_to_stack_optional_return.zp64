// zeropage-emu-error: unsupported stack frame optional
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{
        .main = .{ .frame = .stack },
        .maybe = .{ .frame = .stack },
    } },
};

fn maybe() ?u8 {
    return 5;
}

export fn main() void {
    var value: ?u8 = maybe();
    _ = value;
}
