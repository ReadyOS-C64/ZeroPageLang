// zeropage-emu-error: immutable local binding
const test6502 = @import("test6502");

export fn main() void {
    var x: u8 = 1;
    switch (x) {
        1 => |payload| {
            payload = 2;
            test6502.pass();
        },
        else => {
            test6502.fail(1);
        },
    }
}
