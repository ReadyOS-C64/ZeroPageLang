// zeropage-emu-error: unsupported stack frame bridge argument
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{
        .main = .{ .frame = .stack },
        .helper = .{ .frame = .stack },
        .seed = .{ .frame = .stack },
    } },
};

fn seed() u8 {
    return 4;
}

fn helper(a: u8) u8 {
    return a + 1;
}

export fn main() void {
    var value: u8 = helper(seed());
    _ = value;
}
