// zeropage-emu-error: unsupported stack frame bridge argument
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .worker = .{ .frame = .stack } } },
};

fn staticValue() u8 {
    return 2;
}

fn worker(value: u8) u8 {
    return value + 1;
}

export fn main() void {
    _ = worker(staticValue());
}
