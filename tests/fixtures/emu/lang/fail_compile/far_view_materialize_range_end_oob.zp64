// zeropage-emu-error: unsupported array index
const ZeroPage = @import("ZeroPage");

const Enemy = struct { hp: u8 };

pub const zeropage_options = .{
    .heaps = .{
        .main = .{ .region = .{ .addr = 0x9000, .size = 16 }, .kind = .arena },
    },
    .reu = .{
        .heaps = .{
            .assets = .{ .region = .{ .addr = 0x010000, .size = 0x0100 }, .kind = .arena },
        },
    },
};

export fn main() void {
    const maybe_far = ZeroPage.reu.heap("assets").allocBytes(4);
    if (maybe_far) |far| {
        var enemies = ZeroPage.reu.view(Enemy, far, 4);
        if (enemies.materializeRange("main", 3, 2)) |local| {
            _ = local.len;
        }
    }
}
