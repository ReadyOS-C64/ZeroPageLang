// zeropage-emu-error: unsupported stack frame optional
pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{ .functions = .{ .worker = .{ .frame = .stack } } },
};

fn worker() u8 {
    var maybe: ?u8 = null;
    _ = maybe;
    return 0;
}

export fn main() void {
    _ = worker();
}
