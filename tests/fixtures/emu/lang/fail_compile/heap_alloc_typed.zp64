// zeropage-emu-error: unsupported heap function
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .heaps = .{
        .sprites = .{ .region = .{ .addr = 0x9200, .size = 0x0040 }, .kind = .fixed, .block = 16 },
    },
};

export fn main() void {
    _ = ZeroPage.heap("sprites").alloc(u8, 1);
}
