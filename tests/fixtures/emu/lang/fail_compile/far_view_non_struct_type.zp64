// zeropage-emu-error: unsupported struct
const ZeroPage = @import("ZeroPage");

const Bytes = enum(u8) { a = 1 };

pub const zeropage_options = .{
    .reu = .{
        .heaps = .{
            .assets = .{ .region = .{ .addr = 0x010000, .size = 0x0100 }, .kind = .arena },
        },
    },
};

export fn main() void {
    const maybe_far = ZeroPage.reu.heap("assets").allocBytes(4);
    if (maybe_far) |far| {
        const bytes = ZeroPage.reu.view(Bytes, far, 4);
        _ = bytes;
    }
}
