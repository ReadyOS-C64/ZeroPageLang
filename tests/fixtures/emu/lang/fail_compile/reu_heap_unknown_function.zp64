// zeropage-emu-error: unsupported heap function
const ZeroPage = @import("ZeroPage");

pub const zeropage_options = .{
    .reu = .{
        .heaps = .{
            .assets = .{ .region = .{ .addr = 0x010000, .size = 0x0010 }, .kind = .arena },
        },
    },
};

export fn main() void {
    ZeroPage.reu.heap("assets").free();
}
