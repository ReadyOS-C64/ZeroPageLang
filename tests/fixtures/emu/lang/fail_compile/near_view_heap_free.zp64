// zeropage-emu-error: unsupported pointer type
const ZeroPage = @import("ZeroPage");

const Enemy = struct { hp: u8 };

pub const zeropage_options = .{
    .heaps = .{
        .main = .{ .region = .{ .addr = 0x9000, .size = 16 }, .kind = .arena },
        .blocks = .{ .region = .{ .addr = 0x9100, .size = 16 }, .kind = .fixed, .block = 8 },
    },
    .reu = .{
        .heaps = .{
            .assets = .{ .region = .{ .addr = 0x010000, .size = 0x0100 }, .kind = .arena },
        },
    },
};

export fn main() void {
    const maybe_far = ZeroPage.reu.heap("assets").allocBytes(1);
    if (maybe_far) |far| {
        var enemies = ZeroPage.reu.view(Enemy, far, 1);
        if (enemies.materialize("main")) |local| {
            ZeroPage.heap("blocks").free(local);
        }
    }
}
