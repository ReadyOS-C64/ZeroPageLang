const c64 = @import("c64");
const test6502 = @import("test6502");

const Marker = struct {
    x: u8,
    y: u8,
    ch: u8,
    ok: bool,
};

export fn main() void {
    var marker = Marker{ .x = 4, .y = 2, .ch = 'S', .ok = true };
    test6502.expectA(1, 1);

    c64.screen.clear();
    c64.screen.putsAt(0, 0, "STRUCT");
    if (marker.ok == true) {
        c64.screen.putAt(marker.x, 2, marker.ch);
    } else {
        c64.screen.putAt(0, 2, 'B');
    }
    c64.screen.hexAt(0, 3, marker.x);
    c64.screen.hexAt(3, 3, marker.y);
    c64.screen.hexAt(6, 3, marker.ch);
    test6502.pass();
}
