const math = @import("module_math.zp64");

pub const zeropage_options = .{
    .stack = .{ .base = 0xc800, .size = 0x0400 },
    .abi = .{
        .default_frame = .static,
        .functions = .{
            .math_add8 = .{ .frame = .stack },
            .main = .{ .frame = .static },
        },
    },
};

export fn main() void {
    var value: u8 = math.add8(2, 3);
    _ = value;
}
