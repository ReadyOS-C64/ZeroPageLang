fn crossPage(value: u16) u8 { return switch (value) {
    250...281 => 1,
    282...313 => 2,
    314...345 => 3,
    346...377 => 4,
    378...409 => 5,
    410...441 => 6,
    442...473 => 7,
    474...505 => 8,
    else => 99,
}; }
export fn main() void {
    test6502.expectEqualU8(1, 170, fullByte(255));
    test6502.expectEqualU8(2, 1, crossPage(250));
    test6502.expectEqualU8(3, 8, crossPage(505));
    test6502.expectEqualU8(4, 99, crossPage(506));
    test6502.pass();
}
