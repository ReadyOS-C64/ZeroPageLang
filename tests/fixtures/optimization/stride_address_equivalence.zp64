export fn main() void {
    test6502.expectEqualU16(1, 44036, record3(65535, 3));
    test6502.expectEqualU16(2, 44016, record3(32768, 7));
    test6502.expectEqualU16(3, 44036, record4(65535, 3));
    test6502.expectEqualU16(4, 44016, record4(32768, 7));
    test6502.expectEqualU16(5, 44036, record5(65535, 3));
    test6502.expectEqualU16(6, 44016, record5(32768, 7));
    test6502.expectEqualU16(7, 44036, record9(65535, 3));
    test6502.expectEqualU16(8, 44016, record9(32768, 7));
    test6502.pass();
}
