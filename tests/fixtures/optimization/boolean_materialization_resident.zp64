// Byte/word comparison values, nested boolean AND/OR, and signed equality.
const test6502 = @import("test6502");
pub const zeropage_options = .{ .zero_page = .{ .profile = .kernal, .allocation = .scratch } };
fn andBytes(left: u8, right: u8) bool { return left < right and right != 0; }
fn orBytes(left: u8, right: u8) bool { return left == right or left > right; }
fn chooseByte(left: u8, right: u8) u8 {
    const selected: u8 = if ((left < right and right < 128) or (left == 255 and right != 0)) 0xa5 else 0x5a;
    return selected;
}
fn mixedWords(left: u16, right: u16, gate: bool) u16 {
    const selected: u16 = if ((left <= right or gate) and (left != right or !gate)) 0xa55a else 0x5aa5;
    return selected;
}
fn signedByte(left: i8, right: i8, gate: bool) bool { return (left == right or gate) and left != 128; }
fn signedWord(left: i16, right: i16, gate: bool) bool { return (left != right and gate) or left == 32768; }
export fn main() void {
    test6502.expectEqualBool(1, true, andBytes(1, 2));
    test6502.expectEqualBool(2, false, andBytes(255, 0));
    test6502.expectEqualBool(3, true, orBytes(255, 1));
    test6502.expectEqualU8(4, 0xa5, chooseByte(1, 127));
    test6502.expectEqualU8(5, 0x5a, chooseByte(1, 128));
    test6502.expectEqualU16(6, 0x5aa5, mixedWords(256, 256, true));
    test6502.expectEqualBool(7, false, signedByte(128, 128, true));
    test6502.expectEqualBool(8, true, signedWord(32768, 0, false));
    test6502.pass();
}
