// Materialized booleans remain actual values; no immediate condition consumes them.
const test6502 = @import("test6502");
pub const zeropage_options = .{ .zero_page = .{ .profile = .kernal, .allocation = .scalars } };
fn comparisonValue(left: u8, right: u8) bool { return left < right; }
fn storedValue(left: u16, right: u16) bool { const saved: bool = left == right; return saved; }
export fn main() void {
    test6502.expectEqualBool(1, true, comparisonValue(1, 2));
    test6502.expectEqualBool(2, false, comparisonValue(2, 1));
    test6502.expectEqualBool(3, true, storedValue(0x81ff, 0x81ff));
    test6502.expectEqualBool(4, false, storedValue(0x81ff, 0xff81));
    test6502.pass();
}
