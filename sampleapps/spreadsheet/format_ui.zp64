const c64 = @import("c64");
const tui = @import("tui.zp64");
const paint = @import("paint.zp64");
const dma = @import("dma.zp64");
const store = @import("store.zp64");
const format = @import("format_ui.zp64");

// Column display modes. Slots align with the values stored in REU.
const labels = c64.string.ascii("general     text        integer     decimal (2) currency    ");
const title = c64.string.ascii("Format column ");
const footer = c64.string.ascii("arrows adjust  f3 color");

fn menu(bank: u8, column: u8) void {
    const modes: [*]volatile u8 = @ptrFromInt(0xc310);
    var choice = modes[column] & 15;
    var width = modes[column] & 0xf0;
    tui.rect(7, 7, 27, 10);
    asm {
        ldx #13
    heading:
        lda @format_title.data,x
        cmp #$61
        bcc heading_glyph
        sbc #$60
    heading_glyph:
        sta $0528,x
        lda #7
        sta $d928,x
        dex
        bpl heading
        lda @column
        clc
        adc #$41
        sta $0536
        ldx #22
    commands:
        lda @format_footer.data,x
        cmp #$61
        bcc command_glyph
        sbc #$60
    command_glyph:
        sta $0660,x
        dex
        bpl commands
    }
    while (true) {
        format.rows(choice);
        format.widthLabel(width);
        var key: u8 = 0;
        while (key == 0) {
            key = c64.keyboard.readPetscii();
        }
        if (key == 3 or key == 95) {
            break;
        }
        if (key == 134) {
            asm {
                lda #4
                sta $c0c2
                lda #10
                sta $c0c3
            }
            break;
        }
        if (key == 13) {
            const settings = choice | width;
            if (modes[column] != settings) {
                if (choice == 1 or (modes[column] & 15) == 1) {
                    store.invalidate(bank);
                }
                modes[column] = settings;
                dma.stash(bank, 0xfc40, 0xc310, 16);
                const status: *volatile u8 = @ptrFromInt(0xc0c3);
                status.* = 8;
            }
            break;
        }
        if (key == c64.key.cursor_right and width < 0xc0) {
            width += if ((width & 0x10) != 0) 0x10 else 0x20;
            if (width == 0x20) {
                width = 0x40;
            }
        } else if (key == c64.key.cursor_left and width != 0) {
            width -= if ((width & 0x10) != 0) 0x10 else 0x20;
            if (width == 0x20) {
                width = 0;
            }
        } else if (key == c64.key.cursor_down) {
            if (choice < 4) {
                choice += 1;
            }
        } else if (key == c64.key.cursor_up and choice != 0) {
            choice -= 1;
        }
    }
}

fn rows(choice: u8) void {
    asm {
        lda #$78
        sta $fb
        lda #$05
        sta $fc
        lda #0
        sta $c24a
        ldx #0
    row:
        lda #0
        ldy $c24a
        cpy @choice
        bne mask
        lda #$80
    mask:
        sta $c24b
        ldy #0
    letter:
        lda @format_labels.data,x
        cmp #$61
        bcc item_glyph
        sbc #$60
    item_glyph:
        ora $c24b
        sta ($fb),y
        inx
        iny
        cpy #12
        bne letter
        lda $fb
        clc
        adc #40
        sta $fb
        bcc same_page
        inc $fc
    same_page:
        inc $c24a
        lda $c24a
        cmp #5
        bne row
    }
}

const widths = c64.string.ascii("auto 4 5 6 7 8 9101112");
const width_caption = c64.string.ascii("\x17\x09\x04\x14\x08 ");
fn widthLabel(width: u8) void {
    asm {
        ldx #5
    caption:
        lda @format_width_caption.data,x
        sta $0638,x
        dex
        bpl caption
        lda @width
        beq auto
        lsr
        lsr
        lsr
        lsr
        sec
        sbc #4
        asl
        tax
        lda @format_widths.data+4,x
        sta $063e
        lda @format_widths.data+5,x
        sta $063f
        lda #$20
        sta $0640
        sta $0641
        bne done_width
    auto:
        ldx #3
    copy_auto:
        lda @format_widths.data,x
        cmp #$61
        bcc glyph
        sbc #$60
    glyph:
        sta $063e,x
        dex
        bpl copy_auto
    done_width:
    }
}
