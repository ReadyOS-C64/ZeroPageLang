const colors = @import("colors.zp64");
const color_ui = @import("color_ui.zp64");
const c64 = @import("c64");
const tui = @import("tui.zp64");

const heading = c64.string.ascii("C\x05\x0c\x0c \x03\x0f\x0c\x0f\x12");
const choices = c64.string.ascii("automatic   yellow      green       red         light blue  ");
const palette = c64.string.ascii("\x00\x07\x05\x02\x0e");
const footer = c64.string.ascii("\x12\x05\x14 \x01\x10\x10\x0c\x19  \x13\x14\x0f\x10 \x03\x01\x0e\x03\x05\x0c");

fn menu(bank: u8) u8 {
    var id: u16 = 0;
    asm {
        lda $c0ca
        asl
        rol color_ui_menu_id+1
        asl
        rol color_ui_menu_id+1
        asl
        rol color_ui_menu_id+1
        asl
        rol color_ui_menu_id+1
        ora $c0cb
        sta color_ui_menu_id
    }
    var before = colors.read(bank, id);
    var pick: u8 = 0;
    asm {
        ldx #4
    match:
        lda @color_ui_palette.data,x
        cmp @before
        beq found
        dex
        bpl match
        ldx #0
    found:
        stx @pick
    }
    tui.rect(7, 7, 27, 10);
    asm {
        ldx #9
    title:
        lda @color_ui_heading.data,x
        sta $052a,x
        lda #7
        sta $d92a,x
        dex
        bpl title
        ldx #21
    commands:
        lda @color_ui_footer.data,x
        sta $0660,x
        dex
        bpl commands
    }
    while (true) {
        color_ui.rows(pick);
        const key = c64.keyboard.readPetscii();
        if (key == 3 or key == 95) {
            return 0;
        }
        if (key == 13) {
            var ink: u8 = 0;
            asm {
                ldx @pick
                lda @color_ui_palette.data,x
                sta @ink
            }
            if (ink != before) {
                colors.write(bank, id, ink);
                return 8;
            }
            return 0;
        }
        if (key == c64.key.cursor_up and pick != 0) {
            pick -= 1;
        } else if (key == c64.key.cursor_down and pick < 4) {
            pick += 1;
        }
    }
    return 0;
}

fn rows(pick: u8) void {
    asm {
        lda #$78
        sta $fb
        sta $fd
        lda #$05
        sta $fc
        lda #$d9
        sta $fe
        lda #0
        sta $c24a
        ldx #0
    row:
        ldy $c24a
        lda @color_ui_palette.data,y
        bne ink
        lda #1
    ink:
        sta $c24c
        lda #0
        cpy @pick
        bne mask
        lda #$80
    mask:
        sta $c24b
        ldy #0
    letter:
        lda @color_ui_choices.data,x
        cmp #$61
        bcc glyph
        sbc #$60
    glyph:
        ora $c24b
        sta ($fb),y
        lda $c24c
        sta ($fd),y
        inx
        iny
        cpy #12
        bne letter
        lda $fb
        clc
        adc #40
        sta $fb
        sta $fd
        bcc same_page
        inc $fc
        inc $fe
    same_page:
        inc $c24a
        lda $c24a
        cmp #5
        bne row
    }
}
