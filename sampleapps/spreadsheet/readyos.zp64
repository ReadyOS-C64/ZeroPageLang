const colors = @import("colors.zp64");
const math = @import("numbers.zp64");

const digits = @import("digits.zp64");
const display = @import("decimal_display.zp64");
const bytes = @import("bytes.zp64");
const c64 = @import("c64");
const app = @import("application.zp64");
const calc = @import("calculate.zp64");
const dma = @import("dma.zp64");
const edit_ui = @import("edit_ui.zp64");
const expression = @import("expression.zp64");
const grid = @import("grid.zp64");
const lex = @import("lex.zp64");
const fp = @import("float_rom.zp64");
const overlays = @import("overlays.zp64");
const store = @import("store.zp64");
const results = @import("results.zp64");
const tui = @import("tui.zp64");
const paint = @import("paint.zp64");

const host = @import("host.zp64");
const nav = @import("../tictactoe_readyos/readyos_shim.zp64");

memory {
    region cold_window: c64 at 0xa000 size 0x1f00 bank .ram_under_basic;
    region sheet_workspace: c64 at 0xc000 size 0x0300;
    region dma_zero: c64 at 0xc300 size 1;
    region column_formats: c64 at 0xc310 size 16;
    region column_layout: c64 at 0xc320 size 32;
    region visible_colors: c64 at 0xc340 size 144;
    region rom_work: c64 at 0xc3e0 size 0x00c0;
    region text_operands: c64 at 0xc500 size 0x0100;
    region readyos_shim: c64 at 0xc600 size 0x0400;
    image prg {
        load_addr = 0x1000;
        entry_addr = 0x1000;
        basic_stub = false;
        address_limit = 0xa000;
    }
}

export fn main() void {
    const app_id = host.appId();
    const session: [*]volatile u8 = @ptrFromInt(0xc0f0);
    const drive: *volatile u8 = @ptrFromInt(0xc0c4);
    const host_drive: *volatile u8 = @ptrFromInt(0xc839);
    var exit_key: u8 = 2;
    if (app_id < 64) {
        const work = host.claim(app_id, 0);
        const temp = host.claim(app_id, 1);
        const cold = host.claim(app_id, 2);
        if (work >= 256) {
            const fresh_bank = bytes.low(work);
            results.reset(fresh_bank);
            dma.clear(fresh_bank, 0xfc00, 7);
            dma.clear(fresh_bank, 0xfc10, 32);
            dma.clear(fresh_bank, 0xfc30, 3);
            dma.clear(fresh_bank, 0xfd00, 768);
            dma.clear(fresh_bank, 0xfc40, 16);
        }
        if (cold >= 256) {
            dma.clear(bytes.low(cold), 0x6000, 4);
        }
        if (work != 255 and temp != 255 and cold != 255) {
            fp.install();
            const bank = bytes.low(work);
            const staging = bytes.low(temp);
            const cache = bytes.low(cold);
            dma.fetch(bank, 0xfc00, 0xc0f0, 7);
            dma.fetch(bank, 0xfc10, 0xc0a0, 32);
            dma.fetch(bank, 0xfc30, 0xc0f8, 3);
            drive.* = host_drive.*;
            exit_key = app.run(bank, cache, staging, true);
            dma.stash(bank, 0xfc00, 0xc0f0, 7);
            dma.stash(bank, 0xfc10, 0xc0a0, 32);
            dma.stash(bank, 0xfc30, 0xc0f8, 3);
            host_drive.* = drive.*;
        }
    }
    if (exit_key == 137 and nav.selectNextApp() != 0) {
        asm {
            jmp $c80f
        }
    }
    if (exit_key == 138 and nav.selectPreviousApp() != 0) {
        asm {
            jmp $c80f
        }
    }
    asm {
        jmp $c80c
    }
}
