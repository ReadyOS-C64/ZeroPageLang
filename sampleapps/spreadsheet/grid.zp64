const dma = @import("dma.zp64");
const digits = @import("digits.zp64");
const grid = @import("grid.zp64");
const c64 = @import("c64");
const calc = @import("calculate.zp64");
const store = @import("store.zp64");
const results = @import("results.zp64");
const tui = @import("tui.zp64");
const paint = @import("paint.zp64");
const fp = @import("float_rom.zp64");
const display = @import("decimal_display.zp64");
const bytes = @import("bytes.zp64");

const View = struct {
    row: u8,
    col: u8,
    top: u8,
    left: u8,
    dirty: bool,
};

fn id(row: u8, col: u8) u16 {
    return (@as(u16, row) << 4) | @as(u16, col);
}

fn chrome() void {
    tui.rect(0, 0, 40, 3);
    grid.title();
    tui.ink(12, 14, 7);
    grid.cell_label();
    grid.extent();
    grid.shortcuts();
    tui.ink(960, 40, 15);
}

const errors = [_]u8{
    35, 19, 25, 14, 20, 32, // #SYNT
    35, 18, 5, 6, 32, 32,   // #REF
    35, 3, 25, 3, 12, 5,    // #CYCLE
    35, 20, 25, 16, 5, 32,  // #TYPE
    35, 4, 9, 22, 48, 32,   // #DIV0
    35, 14, 21, 13, 32, 32, // #NUM
    35, 14, 47, 1, 32, 32, // #N/A
    35, 12, 15, 14, 7, 32, // #LONG
};

// The high nibble of each format byte is an explicit field width.
// Rebuild column offsets only when drawing or scrolling the viewport.
fn layout(left: u8) u8 {
    var end: u8 = 0;
    asm {
        ldx @left
        ldy #4
    next:
        lda $c310,x
        lsr
        lsr
        lsr
        lsr
        bne sized
        lda $c0f6
    sized:
        sta $c330,x
        sta $fb
        tya
        sta $c320,x
        clc
        adc $fb
        cmp #41
        bcs done
        tay
        inx
        cpx #16
        bne next
    done:
        stx @end
        stx $c0f7
    }
    return end;
}

fn toggle(bank: u8, view: *View) void {
    const width: *volatile u8 = @ptrFromInt(0xc0f6);
    width.* = if (width.* == 6) 9 else 6;
    grid.draw(bank, view);
}

fn cell(bank: u8, view: *View, row: u8, col: u8) void {
    var width: u8 = 0;
    var x: u8 = 0;
    var number_format: u8 = 0;
    asm {
        ldx @col
        lda $c320,x
        sta @x
        lda $c330,x
        sta @width
        lda $c310,x
        and #15
        sta @number_format
    }
    const y = 5 + row - view.top;
    const offset = @as(u16, y) * 40 + @as(u16, x);
    const selected = view.row == row and view.col == col;
    const mask: u8 = if (selected) 128 else 0;
    paint.span(offset, width, 32 | mask, 7);
    const cell_id = grid.id(row, col);
    calc.evaluate(bank, cell_id);
    results.loadResult(bank, cell_id);
    const state = results.state();
    if (state == 2) {
        const value = results.value();
        // Apply the same sign rule to literals and computed results.
        var ink: u8 = 5;
        if (selected) {
            ink = 7;
        } else if (value >= 0x8000) {
            ink = 10;
        } else if (value == 0) {
            ink = 15;
        }
        if (number_format >= 3) {
            if (fp.integer(bytes.low(value >> 8), bytes.low(value))) {
                grid.numericText(offset, width, ink, mask, number_format);
            }
        } else {
            digits.decimal(offset + @as(u16, width) - 1, value, ink, mask, width);
        }
    } else if (state == 3 or state == 13) {
        if (state == 13) {
            results.text(cell_id, 0, 0xc0, 0x91);
        } else {
            store.read(bank, cell_id);
        }
        grid.textCell(offset, width, mask);
    } else if (state == 11) {
        results.copyFloat(0xc021, 0xc3e0);
        const number_bytes: [*]volatile u8 = @ptrFromInt(0xc3e0);
        const float_ink: u8 = if (mask != 0) 7 else if (number_bytes[0] == 0) 15 else if (number_bytes[1] >= 128) 10 else 5;
        grid.numericText(offset, width, float_ink, mask, number_format);
    } else if (state >= 5) {
        const error_base: u8 = if (state == 14) 42 else if (state == 12) 36 else (state - 5) * 6;
        var j: u8 = 0;
        while (j < 6 and j < width) {
            paint.put(offset + @as(u16, j), grid.errors[error_base + j] | mask, 10);
            j += 1;
        }
    }
    grid.manualInk(offset, width, y - 5, col, mask, state);
}

fn manualInk(offset: u16, width: u8, row: u8, col: u8, mask: u8, state: u8) void {
    asm {
        lda @mask
        bne done
        lda @state
        cmp #2
        bcc done
        cmp #4
        bcc find_ink
        cmp #11
        beq find_ink
        cmp #13
        bne done
    find_ink:
        lda @row
        asl
        asl
        asl
        sta $fb
        lda @col
        lsr
        ora $fb
        tax
        lda $c340,x
        bcc low
        lsr
        lsr
        lsr
        lsr
    low:
        and #15
        beq done
        tax
        lda grid_manualInk_offset
        sta $fb
        lda grid_manualInk_offset+1
        clc
        adc #$d8
        sta $fc
        txa
        ldy @width
    loop:
        dey
        sta ($fb),y
        bne loop
    done:
    }
}

fn textCell(offset: u16, width: u8, mask: u8) void {
    asm {
        lda grid_textCell_offset
        sta $fb
        sta $fd
        lda grid_textCell_offset+1
        clc
        adc #4
        sta $fc
        adc #$d4
        sta $fe
        ldy #0
    loop:
        cpy @width
        beq done
        cpy $c000
        beq done
        lda $c001,y
        cmp #$c1
        bcc printable
        cmp #$db
        bcs printable
        and #$5f
        bne glyph
    printable:
        cmp #$60
        bcc mask_byte
        cmp #$7f
        bcs mask_byte
        sec
        sbc #$20
        bne glyph
    mask_byte:
        and #$3f
    glyph:
        ora @mask
        sta ($fb),y
        lda @mask
        beq cyan
        lda #7
        bne paint
    cyan:
        lda #3
    paint:
        sta ($fd),y
        iny
        bne loop
    done:
    }
}

fn numericText(offset: u16, width: u8, ink: u8, mask: u8, mode: u8) void {
    if (fp.format()) {
        var length: u8 = 0;
        if (mode >= 2) {
            length = display.fixed(width, if (mode >= 3) 2 else 0, mode == 4);
        }
        asm {
            lda grid_numericText_offset
            sta $fb
            sta $fd
            lda grid_numericText_offset+1
            clc
            adc #4
            sta $fc
            adc #$d4
            sta $fe
            lda @mode
            cmp #2
            bcc general
            ldx #$20
            lda @length
            bne aligned
            ldy #0
        overflow:
            lda #$23
            ora @mask
            sta ($fb),y
            lda @ink
            sta ($fd),y
            iny
            cpy @width
            bne overflow
            beq done
        general:
            ldx #0
            lda $c200
            cmp #$20
            bne measure_start
            inx
        measure_start:
            stx $c248
            ldy #0
        measure:
            lda $c200,x
            beq measured
            inx
            iny
            cpy @width
            bne measure
        measured:
            ldx $c248
            tya
            beq done
        aligned:
            sta @length
            lda @width
            sec
            sbc @length
            tay
        draw:
            lda $c200,x
            ora @mask
            sta ($fb),y
            lda @ink
            sta ($fd),y
            inx
            iny
            cpy @width
            bne draw
        done:
        }
    }
}

fn bar(bank: u8, view: *View) void {
    paint.put(48, view.col + 1, 3);
    digits.twoDigits(49, view.row + 1, 3);
    const star: u8 = if (view.dirty) '*' else 32;
    paint.put(77, star, 7);
    store.read(bank, grid.id(view.row, view.col));
    grid.line();
}

fn line() void {
    paint.span(120, 40, 32, 1);
    grid.raw_label();
    tui.ink(120, 4, 15);
    asm {
        ldx #0
    next:
        cpx $c000
        beq done
        lda $c001,x
        ldy $c001
        cpy #$3d
        bne ordinary
        cmp #$41
        bcc ordinary
        cmp #$5b
        bcc put
    ordinary:
        cmp #$c1
        bcc printable
        cmp #$db
        bcs printable
        and #$5f
        bne put
    printable:
        cmp #$60
        bcc normalize
        cmp #$7f
        bcs normalize
        sec
        sbc #$20
        bne put
    normalize:
        and #$3f
    put:
        sta $047d,x
        inx
        bne next
    done:
    }
}

fn draw(bank: u8, view: *View) void {
    var end = grid.layout(view.left);
    while (view.col >= end) {
        view.left += 1;
        end = grid.layout(view.left);
    }
    dma.fetch(bank, 0xfd00 + (@as(u16, view.top) << 3), 0xc340, 144);
    const starts: [*]volatile u8 = @ptrFromInt(0xc320);
    paint.span(160, 40, 32, 14);
    grid.gutter();
    tui.ink(160, 2, 5);
    var x = view.left;
    while (x < end) {
        paint.put(161 + @as(u16, starts[x]), x + 1, 14);
        x += 1;
    }
    var y: u8 = 0;
    while (y < 18) {
        const row = view.top + y;
        const off = @as(u16, y) * 40 + 200;
        digits.twoDigits(off, row + 1, 15);
        paint.put(off + 2, 32, 15); // Clear the spacer after a dialog closes.
        paint.put(off + 3, 0x5d, 12);
        paint.span(off + 4, 36, 32, 15);
        x = view.left;
        while (x < end) {
            grid.cell(bank, view, row, x);
            x += 1;
        }
        y += 1;
    }
    grid.bar(bank, view);
}

fn move(bank: u8, view: *View, key: u8) void {
    const end: *volatile u8 = @ptrFromInt(0xc0f7);
    const old_row = view.row;
    const old_col = view.col;
    const old_top = view.top;
    const old_left = view.left;
    if (key == c64.key.cursor_up and view.row != 0) {
        view.row -= 1;
    } else if (key == c64.key.cursor_down and view.row < 95) {
        view.row += 1;
    } else if (key == c64.key.cursor_left and view.col != 0) {
        view.col -= 1;
    } else if (key == c64.key.cursor_right and view.col < 15) {
        view.col += 1;
    }
    if (view.row < view.top) {
        view.top = view.row;
    } else if (view.row >= view.top + 18) {
        view.top = view.row - 17;
    }
    if (view.col < view.left) {
        view.left = view.col;
    }
    if (old_top != view.top or old_left != view.left or view.col >= end.*) {
        grid.draw(bank, view);
    } else if (old_row != view.row or old_col != view.col) {
        grid.cell(bank, view, old_row, old_col);
        grid.cell(bank, view, view.row, view.col);
        grid.bar(bank, view);
    }
}

// ZeroPage Sheet
const title_text = c64.string.ascii("Z\x05\x12\x0fP\x01\x07\x05 S\x08\x05\x05\x14");
// cell:
const cell_label_text = c64.string.ascii("\x03\x05\x0c\x0c:");
// a1:p96
const extent_text = c64.string.ascii("\x011:\x1096");
// ret edit f3 fx f5/f7 file f6 size f8 ?
const shortcuts_text = c64.string.ascii("\x12\x05\x14 \x05\x04\x09\x14 \x063 \x06\x18 \x065/\x067 \x06\x09\x0c\x05 \x066 \x13\x09\x1a\x05 \x068 ?  ");
// raw:
const raw_label_text = c64.string.ascii("\x12\x01\x17:");
// ##
const gutter_text = c64.string.ascii("##");

fn title() void {
    asm {
        ldx #0
loop:
        lda @grid_title_text.data,x
        sta $040c,x
        lda #1
        sta $d80c,x
        inx
        cpx #14
        bne loop
    }
}

fn cell_label() void {
    asm {
        ldx #0
loop:
        lda @grid_cell_label_text.data,x
        sta $042a,x
        lda #1
        sta $d82a,x
        inx
        cpx #5
        bne loop
    }
}

fn extent() void {
    asm {
        ldx #0
loop:
        lda @grid_extent_text.data,x
        sta $0434,x
        lda #1
        sta $d834,x
        inx
        cpx #6
        bne loop
    }
}

fn shortcuts() void {
    asm {
        ldx #0
loop:
        lda @grid_shortcuts_text.data,x
        sta $07c0,x
        lda #1
        sta $dbc0,x
        inx
        cpx #40
        bne loop
    }
}

fn raw_label() void {
    asm {
        ldx #0
loop:
        lda @grid_raw_label_text.data,x
        sta $0478,x
        lda #1
        sta $d878,x
        inx
        cpx #4
        bne loop
    }
}

fn gutter() void {
    asm {
        ldx #0
loop:
        lda @grid_gutter_text.data,x
        sta $04a0,x
        lda #1
        sta $d8a0,x
        inx
        cpx #2
        bne loop
    }
}
