const calc = @import("calculate.zp64");
const dma = @import("dma.zp64");
const lex = @import("lex.zp64");
const store = @import("store.zp64");
const results = @import("results.zp64");
const expression = @import("expression.zp64");
const fp = @import("float_rom.zp64");

fn literal(id: u16) u8 {
    var raw: [*]volatile u8 = @ptrFromInt(0xc000);
    var value: *volatile u16 = @ptrFromInt(0xc022);
    value.* = 0;
    if (raw[0] == 0) {
        return 4;
    }
    var text_mode: bool = false;
    asm {
        lda calc_literal_id
        and #15
        tax
        lda $c310,x
        and #15
        cmp #1
        bne numeric
        lda #1
        sta @text_mode
    numeric:
    }
    if (text_mode) {
        return 3;
    }
    lex.seek(1);
    lex.space();
    var sign = false;
    const start = lex.position();
    var limit: u16 = 32767;
    if (lex.peek() == '-' or lex.peek() == '+') {
        sign = lex.peek() == '-';
        if (sign) {
            limit = 32768;
        }
        lex.advance();
    }
    const unsigned = lex.position();
    const magnitude = lex.integer(limit);
    if (lex.position() != unsigned and magnitude != 0xffff) {
        lex.space();
        if (lex.peek() == 0) {
            value.* = magnitude;
            if (sign) {
                value.* = 0 - magnitude;
            }
            return 2;
        }
    }
    lex.seek(unsigned);
    if (!lex.numberToken()) {
        return 3;
    }
    const end = lex.position();
    lex.space();
    if (lex.peek() != 0) {
        return 3;
    }
    return if (fp.parse(start, end)) 11 else 10;
}

// On the REU, the DFS frame packs the 11-bit cell ID and 5-bit cursor
// into a word, followed by the next range member. In RAM it is unpacked.
// The next member is saved before descending, so wide ranges never rescan
// their already visited members. $FFFF means start a new reference token.
fn frame(bank: u8, depth: u16, command: u8) void {
    const offset = 0xe400 + (depth << 2);
    if (command == 0x90) {
        asm {
            lda $c032
            sec
            sbc #$01
            asl
            asl
            asl
            ora $c031
            sta $c031
            lda $c034
            sta $c032
            lda $c035
            sta $c033
        }
    }
    dma.transfer(bank, offset, 0xc030, 4, command, 0);
    if (command == 0x91) {
        asm {
            lda $c033
            sta $c035
            lda $c032
            sta $c034
            lda $c031
            tax
            and #$07
            sta $c031
            txa
            lsr
            lsr
            lsr
            clc
            adc #$01
            sta $c032
            lda #$00
            sta $c033
        }
    }
}

fn push(bank: u8, depth: u16, id: u16) void {
    var words: [*]volatile u16 = @ptrFromInt(0xc030);
    words[0] = id;
    words[1] = 2;
    words[2] = 0xffff;
    calc.frame(bank, depth, 0x90);
    results.saveResult(bank, id, 1, 0);
}

// Return a child ID, $FFFF when complete, or $FFFE for a cycle.
fn dependency(bank: u8, slot: u16) u16 {
    const words: [*]volatile u16 = @ptrFromInt(0xc030);
    const bytes: [*]volatile u8 = @ptrFromInt(0xc030);
    lex.seek(bytes[2]);
    while (lex.peek() != 0) {
        const start = lex.position();
        const c = lex.peek();
        if (c == '"') {
            lex.advance();
            while (lex.peek() != '"' and lex.peek() != 0) {
                lex.advance();
            }
            if (lex.peek() != 0) {
                lex.advance();
            }
            continue;
        }
        if (lex.digit(c) or c == '.') {
            const numeric = lex.numberToken();
            continue;
        }
        var first = lex.reference();
        if (first < 1536) {
            var end = lex.rangeEnd();
            if (end >= 1536) {
                end = first;
            } else {
                first = lex.rangeBounds(first, end);
                const bottom: *volatile u16 = @ptrFromInt(0xc04c);
                end = bottom.*;
            }
            var member: u16 = words[2];
            if (member == 0xffff) {
                member = first;
            }
            while (member != 0xffff) {
                results.loadResult(bank, member);
                const state = results.state();
                if (state == 1) {
                    return 0xfffe;
                }
                const next = lex.rangeNext(member, first, end);
                if (state == 0) {
                    bytes[2] = start;
                    if (next == 0xffff) {
                        bytes[2] = lex.position();
                    }
                    words[2] = next;
                    calc.frame(bank, slot, 0x90);
                    return member;
                }
                member = next;
            }
            words[2] = 0xffff;
        } else if (lex.position() == start) {
            // Skip the whole identifier (not just the first letter).
            if (lex.alpha(lex.peek())) {
                while (lex.alpha(lex.peek())) {
                    lex.advance();
                }
            } else {
                lex.advance();
            }
        }
    }
    return 0xffff;
}

fn evaluate(bank: u8, root: u16) void {
    const raw: [*]volatile u8 = @ptrFromInt(0xc000);
    results.loadResult(bank, root);
    if (results.state() == 0) {
        // Blank and literal roots are common during scrolling and full
        // recalculation. They need no DFS frame or visiting write.
        store.read(bank, root);
        if (raw[0] == 0 or raw[1] != '=') {
            const root_kind = calc.literal(root);
            const root_value = results.value();
            results.saveResult(bank, root, root_kind, root_value);
        } else {
            calc.walk(bank, root);
        }
    }
}

fn walk(bank: u8, root: u16) void {
    const words: [*]volatile u16 = @ptrFromInt(0xc030);
    const raw: [*]volatile u8 = @ptrFromInt(0xc000);
    const err: *volatile u8 = @ptrFromInt(0xc041);
    calc.push(bank, 0, root);
    var depth: u16 = 1;
    while (depth != 0) {
        const slot = depth - 1;
        calc.frame(bank, slot, 0x91);
        const id = words[0];
        store.read(bank, id);
        if (raw[0] == 0 or raw[1] != '=') {
            const literal_kind = calc.literal(id);
            const literal_value = results.value();
            results.saveResult(bank, id, literal_kind, literal_value);
            depth -= 1;
        } else {
            const child = calc.dependency(bank, slot);
            if (child < 1536) {
                calc.push(bank, depth, child);
                depth += 1;
            } else {
                if (child == 0xfffe) {
                    results.saveResult(bank, id, 7, 0);
                } else {
                    const output = expression.calculate(bank);
                    const result_kind: *volatile u8 = @ptrFromInt(0xc046);
                    const kind: u8 = if (err.* == 0) result_kind.* else err.*;
                    results.saveResult(bank, id, kind, output);
                }
                depth -= 1;
            }
        }
    }
}

fn recalculate(bank: u8) void {
    var id: u16 = 0;
    while (id < 1536) {
        calc.evaluate(bank, id);
        id += 1;
    }
}
