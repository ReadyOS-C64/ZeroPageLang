const file_ui = @import("file_ui.zp64");
const tui = @import("tui.zp64");
const c64 = @import("c64");

// The cold module has a tiny self-contained dialog to avoid dependencies on
// resident static-call slots. Named inputs are shared through its mailbox.
fn modal(save: u8) bool {
    const name: [*]volatile u8 = @ptrFromInt(0xc0d0);
    const state: [*]volatile u8 = @ptrFromInt(0xc0c4);
    tui.rect(2, 7, 36, 7);
    if (save != 0) {
        file_ui.save_title();
        file_ui.replace_hint();
    } else {
        file_ui.load_title();
        file_ui.browse_hint();
    }
    tui.ink(292, 13, 7);
    file_ui.file_label();
    file_ui.file_commands();
    file_ui.drive_select();
    var len: u8 = 0;
    while (true) {
        asm {
            lda $c0c4
            ora #$30
            sta $05fc
            ldx #0
        next:
            lda #$20
            cpx @len
            beq cursor
            bcs draw
            lda $c0d0,x
            cmp #$41
            bcc draw
            and #$1f
            bpl draw
        cursor:
            lda #$a0
        draw:
            sta $0573,x
            inx
            cpx #16
            bne next
        }
        const key = c64.keyboard.readPetscii();
        if (key == 3 or key == 95) {
            return false;
        }
        if (key == 133) {
            state[0] = if (state[0] == 8) 9 else 8;
        } else if (key == 134 and save == 0) {
            asm {
                lda #3
                sta $c0c2
                lda #9
                sta $c0c3
            }
            return false;
        } else if (key == 134 and save != 0 and len != 0) {
            return file_ui.finishName(len, 2);
        } else if (key == 13 and len != 0) {
            return file_ui.finishName(len, save);
        } else if (key == 20 and len != 0) {
            len -= 1;
        } else if (len < 15) {
            var letter = key;
            if (key >= 193 and key <= 218) {
                letter = key & 127;
            }
            if ((letter >= 0x41 and letter <= 0x5a) or (letter >= '0' and letter <= '9') or letter == '-') {
                name[len] = letter;
                len += 1;
            }
        }
    }
    return false;
}

const browse_text = c64.string.ascii("\x063: \x02\x12\x0f\x17\x13\x05 \x04\x09\x13\x0b");
fn browse_hint() void {
    asm {
        ldx #14
    copy:
        lda @file_ui_browse_text.data,x
        sta $0594,x
        dex
        bpl copy
    }
}

fn finishName(len: u8, mode: u8) bool {
    if (len == 0) {
        return false;
    }
    asm {
        ldx @len
        ldy @mode
        lda #$2c
        sta $c0d0,x
        sta $c0d2,x
        lda #$53
        sta $c0d1,x
        lda #$52
        cpy #0
        beq suffix
        lda #$57
    suffix:
        sta $c0d3,x
        txa
        clc
        adc #4
        sta $c0c5
        ; DOS save-with-replace. Let the drive handle the old file.
        cpy #2
        bne done
        tax
        dex
    shift:
        lda $c0d0,x
        sta $c0d3,x
        dex
        bpl shift
        lda #$40
        sta $c0d0
        lda #$30
        sta $c0d1
        lda #$3a
        sta $c0d2
        lda $c0c5
        clc
        adc #3
        sta $c0c5
    done:
    }
    return true;
}

const replace_text = c64.string.ascii("\x063: \x12\x05\x10\x0c\x01\x03\x05 \x13\x01\x0d\x05 \x0e\x01\x0d\x05");
fn replace_hint() void {
    asm {
        ldx #20
    copy:
        lda @file_ui_replace_text.data,x
        sta $0594,x
        dex
        bpl copy
    }
}

// Save workbook
const save_title_text = c64.string.ascii("S\x01\x16\x05 \x17\x0f\x12\x0b\x02\x0f\x0f\x0b");
// Load workbook
const load_title_text = c64.string.ascii("L\x0f\x01\x04 \x17\x0f\x12\x0b\x02\x0f\x0f\x0b");
// file:
const file_label_text = c64.string.ascii("\x06\x09\x0c\x05:");
// ret ok del edit run/stop cancel
const file_commands_text = c64.string.ascii("\x12\x05\x14 \x0f\x0b \x04\x05\x0c \x05\x04\x09\x14 \x12\x15\x0e/\x13\x14\x0f\x10 \x03\x01\x0e\x03\x05\x0c");
// f1: drive 8/9     drive:
const drive_select_text = c64.string.ascii("\x061: \x04\x12\x09\x16\x05 8/9     \x04\x12\x09\x16\x05:");

fn save_title() void {
    asm {
        ldx #0
loop:
        lda @file_ui_save_title_text.data,x
        sta $0524,x
        inx
        cpx #13
        bne loop
    }
}

fn load_title() void {
    asm {
        ldx #0
loop:
        lda @file_ui_load_title_text.data,x
        sta $0524,x
        inx
        cpx #13
        bne loop
    }
}

fn file_label() void {
    asm {
        ldx #0
loop:
        lda @file_ui_file_label_text.data,x
        sta $056c,x
        inx
        cpx #5
        bne loop
    }
}

fn file_commands() void {
    asm {
        ldx #0
loop:
        lda @file_ui_file_commands_text.data,x
        sta $05bc,x
        inx
        cpx #31
        bne loop
    }
}

fn drive_select() void {
    asm {
        ldx #0
loop:
        lda @file_ui_drive_select_text.data,x
        sta $05e4,x
        inx
        cpx #24
        bne loop
    }
}
