const ZeroPage=@import("ZeroPage");pub const zeropage_options=.{.heaps=.{.pool=.{.region=.{.addr=0x9000,.size=0x100},.kind=.fixed,.block=8}},.zero_page=.{.profile=.kernal,.allocation=.scalars}};fn release(p:[*]u8,tag:u8)u8{ZeroPage.heap("pool").free(p);return tag;}export fn api(p:[*]u8)u8{return release(p,7);}export fn main()void{}
